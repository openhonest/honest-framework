#!/usr/bin/env bash
# pre-commit — Verification First: no commit lands while the framework fails its own linter,
# its conformance suites, its 100% dogfooding bar, or its function-point invariant (one gherkin
# scenario per function). Each gate fires only when its inputs are staged; a commit that touches
# neither Python nor a feature file is never blocked.
#
# This file is the tracked source of the gate, not necessarily the file git runs: git runs
# whatever `core.hooksPath` points at, and a hook-managing tool may have copied this one
# elsewhere and repointed the path. `./bootstrap.sh` verifies the hook git will actually
# execute invokes the gate. Re-run it after editing this file.
set -uo pipefail
root=$(git rev-parse --show-toplevel)

staged=$(git diff --cached --name-only --diff-filter=ACM)
py=$(printf '%s\n' "$staged" | grep -E '^python/.*\.py$' || true)
feat=$(printf '%s\n' "$staged" | grep -E '\.feature$' || true)
gram=$(printf '%s\n' "$staged" | grep -E '^python/tree-sitter-[a-z-]+/grammar\.js$' || true)

[ -z "$py" ] && [ -z "$feat" ] && [ -z "$gram" ] && exit 0

# The grammar gate fires on a staged tree-sitter grammar: its generated parser must be staged
# with it and must be what the CLI generates, or the old parser keeps parsing under a new grammar.
if [ -n "$gram" ]; then
    echo "grammar gate (generated parser follows grammar.js)…"
    "$root/python/grammar-gate.sh" || exit 1
fi

if [ -n "$py" ]; then
    echo "honest-check gate (staged Python detected)…"
    "$root/python/lint-affected.sh" || exit 1   # structural: must be Honest Code
    "$root/python/coverage-all.sh"  || exit 1   # behavioural: all conformance suites pass AND 100% line+branch coverage
fi

# The slop-audit gate: the sister measure (Slop Audit's L1 analyzer) run against the active source. It
# fails the commit on a production god-file or promiscuous, non-finitely-testable state — a regression
# the honest-check gate above does not catch. It audits python/ only (not python.botched/, the archive).
# Skipped, not failed, when slop-audit is not checked out alongside honest-framework.
if [ -n "$py" ]; then
    l1="$root/../slop-audit/tools/l1_analyzer"
    if [ -d "$l1" ]; then
        echo "slop-audit gate (no god-file, finitely testable)…"
        # Resolve the console script rather than hardcoding it. The script name has been renamed
        # once (l1-analyzer -> slop-audit-l1) and so has the entry point (cli:main -> cli:run),
        # so match the module and take whatever name and function it currently binds. Portable
        # sed, not a grep lookahead: -E has no (?=...), so the old pattern errored out and
        # resolved to empty on every run, which silenced this gate on every commit.
        l1_bin=$(sed -n 's/^\([a-z0-9-][a-z0-9-]*\)[[:space:]]*=[[:space:]]*"l1_analyzer\.cli:[a-z_][a-z_]*".*/\1/p' "$l1/pyproject.toml" | head -1)
        if [ -n "$l1_bin" ]; then
            uv run --project "$l1" "$l1_bin" "$root/python" --gate --lang python || exit 1
        else
            # slop-audit is checked out, so this gate is meant to run. Failing to resolve its
            # entry point is a broken gate, not an absent one, and a broken gate must not pass
            # quietly: a skip changes who is misled rather than excusing anyone.
            echo "slop-audit gate BROKEN: no console script binding l1_analyzer.cli:* in" >&2
            echo "  $l1/pyproject.toml. The gate is present but unrunnable, so it is failing" >&2
            echo "  rather than skipping. Fix the resolution above, or remove the gate." >&2
            exit 1
        fi
    else
        echo "slop-audit gate skipped: l1_analyzer not found at $l1 (clone slop-audit beside honest-framework to enable it)." >&2
    fi
fi

# The feature gate fires on staged Python (a new/removed function changes the function set) OR a
# staged feature file (the scenario set changed). Affected modules only — it tests what changed.
if [ -n "$py" ] || [ -n "$feat" ]; then
    echo "feature gate (one gherkin per function)…"
    "$root/python/feature-gate.sh" || exit 1
fi

# The mutation gate fires on staged module source: every staged src file must be mutation-adequate
# (each surviving mutant caught by a conformance case or declared equivalent in mutants_setaside.json).
# File-scoped — it mutates only the changed files, not their whole module — so a single-file edit stays
# fast; the whole-tree backstop (mutate-all.sh) runs in CI. mutate-affected.sh self-filters to src, so
# a conformance-only or non-Python change never reaches it. This is the heaviest gate, so it runs last.
if [ -n "$py" ]; then
    echo "mutation gate (staged source is mutation-adequate)…"
    "$root/python/mutate-affected.sh" || exit 1
fi
