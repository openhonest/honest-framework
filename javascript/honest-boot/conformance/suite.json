{
  "module": "honest-boot",
  "note": "The portable honest-boot conformance suite: language-agnostic cases for the pure data functions. A case names a public function and its arguments and gives the expected result; the runner resolves the function, applies it, and deep-compares. Elements are plain data objects ({attributes:[{name}], classList:[]}), so the data functions need no DOM. scan (takes an injected query) and readConfig (reads element.getAttribute) take functions, not data, so they are covered by the unit tests, not this portable suite.",
  "cases": [
    {"id": "selector", "function": "buildSelector", "args": [{"prefixes": {"hf": "honest-format", "hd": "honest-drag"}, "attributes": {"hf": ["hf-format"], "hd": ["hd-draggable"]}, "classPrefixes": {"fmt": "hf"}}], "expected": "[hf-format],[hd-draggable],[hf],[hd],[class*=\"fmt-\"]"},
    {"id": "resolve-attribute", "function": "resolvePrefix", "args": [{"attributes": [{"name": "hf-format"}], "classList": []}, {"prefixes": {"hf": "honest-format", "hd": "honest-drag"}, "attributes": {"hf": ["hf-format"], "hd": ["hd-draggable"]}, "classPrefixes": {"fmt": "hf"}}], "expected": "hf"},
    {"id": "resolve-class", "function": "resolvePrefix", "args": [{"attributes": [], "classList": ["fmt-currency"]}, {"prefixes": {"hf": "honest-format"}, "attributes": {"hf": ["hf-format"]}, "classPrefixes": {"fmt": "hf"}}], "expected": "hf"},
    {"id": "resolve-none", "function": "resolvePrefix", "args": [{"attributes": [{"name": "data-x"}], "classList": []}, {"prefixes": {"hf": "honest-format"}, "attributes": {"hf": ["hf-format"]}, "classPrefixes": {"fmt": "hf"}}], "expected": null},
    {"id": "needed", "function": "neededModules", "args": [[{"attributes": [{"name": "hf-format"}], "classList": []}, {"attributes": [{"name": "hd-draggable"}], "classList": []}], {"prefixes": {"hf": "honest-format", "hd": "honest-drag"}, "attributes": {"hf": ["hf-format"], "hd": ["hd-draggable"]}, "classPrefixes": {"fmt": "hf"}}], "expected": ["honest-drag", "honest-format"]}
  ]
}
