{
  "module": "honest-components",
  "note": "The portable honest-components conformance suite: language-agnostic cases every implementation must pass. A case is either element-shaped (a public function, an `element` of attributes wrapped so getAttribute reads it, and any `rest` args) or args-shaped (literal positional `args`); the runner applies the function and deep-compares. Portable: the pure per-component behaviours (toggled/handle for the switch, accordionExpanded/accordionHandle for the accordion) and the CSS namespace contract transforms (scopeCss, tokenContractViolations, mergeTokenContracts, section 6). Unit-tested only: the shared runtime's enhance and scan need an event bus, splitRules is an internal helper of scopeCss, and mergeTokenContracts' loud-failure path is a throw. genX's uix is the reference of record.",
  "cases": [
    {
      "id": "toggled-on",
      "function": "toggled",
      "element": {
        "aria-checked": "true"
      },
      "expected": false
    },
    {
      "id": "toggled-off",
      "function": "toggled",
      "element": {
        "aria-checked": "false"
      },
      "expected": true
    },
    {
      "id": "toggled-absent",
      "function": "toggled",
      "element": {},
      "expected": true
    },
    {
      "id": "handle-click",
      "function": "handle",
      "element": {
        "aria-checked": "false"
      },
      "rest": [
        {
          "type": "click"
        }
      ],
      "expected": {
        "aria-checked": "true",
        "_preventDefault": false
      }
    },
    {
      "id": "handle-click-on",
      "function": "handle",
      "element": {
        "aria-checked": "true"
      },
      "rest": [
        {
          "type": "click"
        }
      ],
      "expected": {
        "aria-checked": "false",
        "_preventDefault": false
      }
    },
    {
      "id": "handle-enter",
      "function": "handle",
      "element": {
        "aria-checked": "false"
      },
      "rest": [
        {
          "type": "keydown",
          "key": "Enter"
        }
      ],
      "expected": {
        "aria-checked": "true",
        "_preventDefault": true
      }
    },
    {
      "id": "handle-space",
      "function": "handle",
      "element": {
        "aria-checked": "false"
      },
      "rest": [
        {
          "type": "keydown",
          "key": " "
        }
      ],
      "expected": {
        "aria-checked": "true",
        "_preventDefault": true
      }
    },
    {
      "id": "handle-other-key",
      "function": "handle",
      "element": {
        "aria-checked": "false"
      },
      "rest": [
        {
          "type": "keydown",
          "key": "a"
        }
      ],
      "expected": null
    },
    {
      "id": "acc-expanded-on",
      "function": "accordionExpanded",
      "element": {
        "aria-expanded": "true"
      },
      "expected": false
    },
    {
      "id": "acc-expanded-off",
      "function": "accordionExpanded",
      "element": {
        "aria-expanded": "false"
      },
      "expected": true
    },
    {
      "id": "acc-expanded-absent",
      "function": "accordionExpanded",
      "element": {},
      "expected": true
    },
    {
      "id": "acc-handle-click",
      "function": "accordionHandle",
      "element": {
        "aria-expanded": "false"
      },
      "rest": [
        {
          "type": "click"
        }
      ],
      "expected": {
        "aria-expanded": "true",
        "_preventDefault": false
      }
    },
    {
      "id": "acc-handle-click-on",
      "function": "accordionHandle",
      "element": {
        "aria-expanded": "true"
      },
      "rest": [
        {
          "type": "click"
        }
      ],
      "expected": {
        "aria-expanded": "false",
        "_preventDefault": false
      }
    },
    {
      "id": "acc-handle-enter",
      "function": "accordionHandle",
      "element": {
        "aria-expanded": "false"
      },
      "rest": [
        {
          "type": "keydown",
          "key": "Enter"
        }
      ],
      "expected": {
        "aria-expanded": "true",
        "_preventDefault": true
      }
    },
    {
      "id": "acc-handle-space",
      "function": "accordionHandle",
      "element": {
        "aria-expanded": "false"
      },
      "rest": [
        {
          "type": "keydown",
          "key": " "
        }
      ],
      "expected": {
        "aria-expanded": "true",
        "_preventDefault": true
      }
    },
    {
      "id": "acc-handle-other-key",
      "function": "accordionHandle",
      "element": {
        "aria-expanded": "false"
      },
      "rest": [
        {
          "type": "keydown",
          "key": "a"
        }
      ],
      "expected": null
    },
    {
      "id": "scope-unnamespaced",
      "function": "scopeCss",
      "args": [".row { color: red }", "data-table"],
      "expected": ".data-table .row { color: red }"
    },
    {
      "id": "scope-already-namespaced",
      "function": "scopeCss",
      "args": [".data-table__row { x: 1 }", "data-table"],
      "expected": ".data-table__row { x: 1 }"
    },
    {
      "id": "scope-global-left-alone",
      "function": "scopeCss",
      "args": ["html { x: 1 }", "data-table"],
      "expected": "html { x: 1 }"
    },
    {
      "id": "scope-inside-media",
      "function": "scopeCss",
      "args": ["@media screen { .row { x: 1 } }", "data-table"],
      "expected": "@media screen {.data-table .row { x: 1 }}"
    },
    {
      "id": "tokens-clean",
      "function": "tokenContractViolations",
      "args": [{ "block": "button", "tokens": { "--button-height": "Control height" } }, "a { height: var(--button-height) }"],
      "expected": []
    },
    {
      "id": "tokens-undeclared",
      "function": "tokenContractViolations",
      "args": [{ "block": "button", "tokens": {} }, "a { height: var(--button-height) }"],
      "expected": ["CSS references --button-height but style.json does not declare it"]
    },
    {
      "id": "merge-distinct",
      "function": "mergeTokenContracts",
      "args": [[{ "block": "button", "tokens": { "--button-height": "h" } }, { "block": "data-table", "tokens": { "--data-table-bg": "b" } }]],
      "expected": { "--button-height": "h", "--data-table-bg": "b" }
    }
  ]
}
