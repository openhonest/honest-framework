module honest-persist-pure

  layer data
  note "the boundaryless public query builders, model-field metadata and refresh decision in the honest-persist distribution (spec 7.2, 7.3 and 8)."

  inputs = { }
  outputs = { }

  # The shared Persist Fault return arm has its single record declaration in honest-persist.
  type Reference = foreign "honest-persist.Reference"
  type Field = foreign "honest-persist.Field"
  type Value = foreign "honest-persist.Value"
  type Query = foreign "honest-persist.Query"
  type QueryJoin = foreign "honest-persist.QueryJoin"
  type Schema = foreign "honest-persist.Schema"
  type Attempt = foreign "honest-persist.Attempt"
  type Disposition = foreign "honest-persist.Disposition"

  fn field : (renamed_from: str | NOTHING, references: Reference | NOTHING) -> Field note "what a host says about one column that its annotation cannot: what it was renamed from, and where it points." note "a host writes it as the column's assignment, so the answer has to be something the model system accepts there: it carries the pair in the field's extra and schema_read_declared reads it back, which is the only way Column.renamed_from and Column.references are ever anything but the named absence. Without it a rename reads as a drop and an add, name_what_is_ambiguous stops the open, and nothing the host can write resolves it. Neither argument has a default, because a column that forgot to say where it points and a column that points nowhere are different facts and only the host knows which"

  fn select : (table: str, columns: list<str> | NOTHING, where: dict<str, Value> | NOTHING, order_by: list<str> | NOTHING, limit: int | NOTHING, offset: int | NOTHING, joins: list<QueryJoin> | NOTHING) -> Query note "builds a SELECT Query from names (spec 7.2). `table` is the table read. `columns` is the column names wanted, or NOTHING for all of them; a single `*` in the list is the all-columns wildcard. `where` is a map of column name to the Value it must equal, or NOTHING for no filter, and an empty map is also no filter. `order_by` is the column names to sort by, each optionally prefixed `-` for descending, or NOTHING. `limit` and `offset` are the row cap and the start offset, or NOTHING for neither. `joins` is the tables joined in, each a QueryJoin of a table name and a raw ON expression, or NOTHING." note "every optional part is an explicit NOTHING when absent, never a language default, so a caller that named nothing and a caller that chose nothing read the same. It produces parameterized SQL with every value carried in the Query's named `params`, and does no I/O. The callers of record phrase it `select(\"events\", [\"event_id\"], {\"aggregate_id\": x})` and `select(\"alert_routes\", [\"*\"], {})`, so columns and where arrive filled and the rest NOTHING."

  fn insert : (table: str, values: dict<str, Value>) -> Query note "builds an INSERT Query (spec 7.2): `table` is the table written and `values` is the map of column name to the Value to write into it. It produces parameterized SQL with every value carried in the Query's named `params`, and does no I/O."

  fn update : (table: str, values: dict<str, Value>, where: dict<str, Value>) -> Query note "builds an UPDATE Query (spec 7.2): `table` is the table written, `values` is the map of column name to the Value to set, and `where` is the map of column name to the Value a row must equal to be updated. An empty `where` map updates every row. It produces parameterized SQL with every value carried in the Query's named `params`, and does no I/O."

  fn delete : (table: str, where: dict<str, Value>) -> Query note "builds a DELETE Query (spec 7.2): `table` is the table written and `where` is the map of column name to the Value a row must equal to be deleted. An empty `where` map deletes every row. It produces parameterized SQL with every value carried in the Query's named `params`, and does no I/O."

  fn raw : (sql: str, params: dict<str, Value> | NOTHING) -> Query note "builds a Query from SQL the caller wrote (spec 7.2): `sql` is the raw SQL text, and `params` is the named parameters to bind, or NOTHING when the SQL carries none. It is the one builder that carries no column names to check, the boundary raw draws between the checked and unchecked building of spec 7.3. It does no I/O."

  fn checked_select : (schema: Schema, table: str, columns: list<str> | NOTHING, where: dict<str, Value> | NOTHING, order_by: list<str> | NOTHING, limit: int | NOTHING, offset: int | NOTHING, joins: list<QueryJoin> | NOTHING) -> Query | Fault invokes select, is_fault, refused note "builds a SELECT Query exactly as select does, but first checks every name the query uses against the declared schema, so a misspelled or undeclared column — `emial` for `email` — is caught at build time rather than reaching the database as a runtime error in production (spec 7.3). This is validation against the declared schema, not the live database: it needs no connection and does no I/O, and honest-test enumerates it as a pure function. `schema` is the module's own Schema (its declared tables and views), out of which the check reads the named table's declared columns; `table`, `columns`, `where`, `order_by`, `limit`, `offset` and `joins` are exactly select's arguments and mean exactly what they mean there, each optional part an explicit NOTHING when absent. On success it returns the very Query select builds from `table` and the same arguments, so the checked and raw layers never diverge." note "EVERY NAMED COLUMN IS CHECKED against the table's declared columns: the selected `columns`, the `where` keys, and the `order_by` keys. Three things are recognised and NOT column-checked: a `*` in `columns` (the all-columns wildcard), a leading `-` on an `order_by` key (the descending marker, stripped before the rest is checked), and a join's `on` expression, which is raw SQL and never column-checked, the same boundary raw draws. A join's named `table` IS checked for existence in the schema. It returns the module's bare-union Fault, never spec 7.3's ok/err envelope: `unknown_table` when `table` (or a join's table) is not a declared table, its `detail` naming that table; and `unknown_column` when any named column is not declared, its `detail` carrying the table, the columns that were not found, and the columns the table does declare, so a caller reads the mismatch as data without parsing a message." note "the boundaries a scenario has to hit: a select whose table, selected columns, where keys and order_by keys are all declared, answered as exactly the Query select builds from the same arguments; a `*` in columns and a `-`-prefixed order_by key, both skipped so a query naming only those is not faulted on them; a join whose table is declared and whose on names columns, where the table is checked and the on expression is left alone; a table no schema declares, an unknown_table Fault naming it; a selected column, a where key, or an order_by key no table declares, an unknown_column Fault naming the offending columns and the table's declared columns; and a join naming a table the schema does not hold, an unknown_table Fault."

  fn checked_insert : (schema: Schema, table: str, values: dict<str, Value>) -> Query | Fault invokes insert, is_fault, refused note "builds an INSERT Query exactly as insert does, after checking its names against the declared schema (spec 7.3): a pure check against the declared Schema, no connection and no I/O, enumerated by honest-test. `schema` is the module's own Schema; `table` and `values` are insert's arguments. It checks that `table` is a declared table and that every key of `values` (the columns written) is a declared column of that table. On success it returns the very Query insert builds, so the checked and raw layers never diverge." note "it returns the module's bare-union Fault, never spec 7.3's ok/err envelope: `unknown_table` when `table` is not declared, its `detail` naming that table; and `unknown_column` when any key of `values` is not a declared column, its `detail` carrying the table, the value keys that were not found, and the table's declared columns." note "the boundaries a scenario has to hit: a table and value keys all declared, answered as exactly the Query insert builds; a table no schema declares, an unknown_table Fault naming it; and a value key no table declares, an unknown_column Fault naming it and the table's declared columns."

  fn checked_update : (schema: Schema, table: str, values: dict<str, Value>, where: dict<str, Value>) -> Query | Fault invokes update, is_fault, refused note "builds an UPDATE Query exactly as update does, after checking its names against the declared schema (spec 7.3): a pure check against the declared Schema, no connection and no I/O, enumerated by honest-test. `schema` is the module's own Schema; `table`, `values` and `where` are update's arguments. It checks that `table` is a declared table, that every key of `values` (the columns set) is a declared column, and that every key of `where` (the columns a row must match) is a declared column. On success it returns the very Query update builds, so the checked and raw layers never diverge." note "it returns the module's bare-union Fault, never spec 7.3's ok/err envelope: `unknown_table` when `table` is not declared, its `detail` naming that table; and `unknown_column` when any key of `values` or `where` is not a declared column, its `detail` carrying the table, the keys that were not found, and the table's declared columns." note "the boundaries a scenario has to hit: a table, value keys and where keys all declared, answered as exactly the Query update builds; a table no schema declares, an unknown_table Fault; a value key no table declares, an unknown_column Fault naming it; and a where key no table declares, an unknown_column Fault naming it."

  fn checked_delete : (schema: Schema, table: str, where: dict<str, Value>) -> Query | Fault invokes delete, is_fault, refused note "builds a DELETE Query exactly as delete does, after checking its names against the declared schema (spec 7.3): a pure check against the declared Schema, no connection and no I/O, enumerated by honest-test. `schema` is the module's own Schema; `table` and `where` are delete's arguments. It checks that `table` is a declared table and that every key of `where` (the columns a row must match to be deleted) is a declared column of that table. On success it returns the very Query delete builds, so the checked and raw layers never diverge." note "it returns the module's bare-union Fault, never spec 7.3's ok/err envelope: `unknown_table` when `table` is not declared, its `detail` naming that table; and `unknown_column` when any key of `where` is not a declared column, its `detail` carrying the table, the where keys that were not found, and the table's declared columns." note "the boundaries a scenario has to hit: a table and where keys all declared, answered as exactly the Query delete builds; a table no schema declares, an unknown_table Fault naming it; and a where key no table declares, an unknown_column Fault naming it and the table's declared columns."

  fn what_to_do_after_a_refresh : (written: int | Fault, attempt: Attempt, attempts_allowed: int) -> Disposition invokes worth_retrying, budget_spent note "reads one refresh's outcome and says whether to run again or stop; the rule the scheduler calls and never reads into." note "it is this package's because the fault categories are, and it asks the two cards that already know them rather than reading a category itself: worth_retrying answers that only a conflict is worth another go, and budget_spent answers whether the tries are gone. `attempt` is handed in rather than counted here, which keeps it pure. `attempts_allowed` is the host's number, read off the view it declared, so what the scheduler is handed still takes two arguments." note "IT NEVER ANSWERS retry_after: a refresh already has its cadence as the spacing, so a conflict worth another go is answered `continue` and tried again on the next tick. Answering retry_after would mean minting a delay, and this rule holds no clock to mint one with. attempt.overran changes nothing it answers, because the scheduler never starts a second run while the first is still going"

  fn is_fault : (value: any) -> bool pure_call "honest-type.is_fault" note "recognizes a fault in a Persist result that may be a row list, count, boolean, absence or record. A value that is not a record is false. For a record it delegates to the Honest Type fault recognizer, preserving the existing fault discriminator."

  fn refused : (code: str, message: str, detail: dict<str, any>) -> Fault pure_call "honest-type.fault" note "constructs the Persist fault for a refused request through the shared fault constructor. code names the refused condition, message tells the caller what went wrong, and detail supplies its structured facts. The retry category is refused, the reserved tag is present, and results is empty."

  fn worth_retrying : (fault: Fault) -> bool note "answers whether a failure is worth another attempt, asked of its category: only a conflict is, because two writers wrote one row so trying again may win it, while a refused request, a spent budget and a killed process never improve on a retry"

  fn budget_spent : (attempts: int, budget: int) -> bool note "answers whether the retry budget is gone: true when the attempts made have reached the budget allowed, so a budget of three is spent at the third attempt"

  entry "export honest_persist" -> field
  entry "export honest_persist" -> select
  entry "export honest_persist" -> insert
  entry "export honest_persist" -> update
  entry "export honest_persist" -> delete
  entry "export honest_persist" -> raw
  entry "export honest_persist" -> checked_select
  entry "export honest_persist" -> checked_insert
  entry "export honest_persist" -> checked_update
  entry "export honest_persist" -> checked_delete
  entry "export honest_persist" -> what_to_do_after_a_refresh
