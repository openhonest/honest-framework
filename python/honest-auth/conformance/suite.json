{
  "module": "honest-auth",
  "cases": [
    {"id": "value-auth-fault", "value_case": {"function": "auth_fault", "args": ["unauthenticated", "already_registered", "a provider is already active", {"existing": "dev"}], "expected": {"is_err": true, "category": "unauthenticated", "code": "already_registered", "message": "a provider is already active", "detail": {"existing": "dev"}}}},

    {"id": "value-expect-actor-pass", "value_case": {"function": "_expect_actor", "args": ["valid", {"user_id": "u1"}], "expected": true}},
    {"id": "value-expect-actor-fail", "value_case": {"function": "_expect_actor", "args": ["valid", {"is_err": true, "category": "unauthenticated", "code": "revoked", "message": "m", "detail": {}}], "expected": false}},

    {"id": "value-expect-unauth-pass", "value_case": {"function": "_expect_unauthenticated", "args": ["revoked", {"is_err": true, "category": "unauthenticated", "code": "revoked", "message": "m", "detail": {}}], "expected": true}},
    {"id": "value-expect-unauth-fail", "value_case": {"function": "_expect_unauthenticated", "args": ["revoked", {"user_id": "u1"}], "expected": false}},

    {"id": "value-expect-reject-pass",      "value_case": {"function": "_expect_recognizer_reject", "args": ["malformed", {"is_err": true, "category": "unauthenticated", "code": "malformed_token", "message": "m", "detail": {}}], "expected": true}},
    {"id": "value-expect-reject-wrong-code","value_case": {"function": "_expect_recognizer_reject", "args": ["malformed", {"is_err": true, "category": "unauthenticated", "code": "revoked", "message": "m", "detail": {}}], "expected": false}},
    {"id": "value-expect-reject-actor",     "value_case": {"function": "_expect_recognizer_reject", "args": ["malformed", {"user_id": "u1"}], "expected": false}}
  ]
}
