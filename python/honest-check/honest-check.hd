# honest-check declared in .hd — the static linter, the honesty gate. check_source parses source and
# returns diagnostics (pure over the parse tree, via honest-parse); startup_check reads a source tree
# from disk and runs the eligible rules at framework startup.

module honest-check

  layer tooling

  # The surface, closed: every side of the world a boundary here touches, and no other.
  inputs = { "filesystem" }

  type Diagnostic = {
    rule_id: str
    severity: str
    message: str
    source_location: str
  }

  fn check_source : (source: str, path: str, language: str) -> list<Diagnostic>

  fn check_hc_r002 : (root: any, source: bytes, path: str, roles: dict<str, str>) -> list<Diagnostic>
  fn check_hc_r003 : (root: any, source: bytes, path: str, awaited: dict<str, bool>) -> list<Diagnostic>
  fn declared_roles : (source: str) -> Result
  fn declared_awaited : (source: str) -> Result
  fn undeclared_members : (members: set<str>, with_declaration: set<str>) -> list<str>
  fn declared_column : (role: str) -> int

  boundary_in fn startup_check : (paths: list<str>, on_error: str, severity: str) -> list<Diagnostic> side_effect reads "filesystem"
