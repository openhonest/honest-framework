# honest-errors declared in .hd — the error-policy leaf. All pure: two raw payloads normalized to
# one report, behaviour as a pure function of the environment, a state-threaded throttle. No I/O
# (logging and sending belong to honest-observe and honest-alerts, which compose this leaf).

module honest-errors

  layer correctness

  set SEVERITIES = { "critical", "error", "warning", "info" }
  set ENVIRONMENTS = { "development", "production", "test" }
  set BEHAVIOR_NAMES = { "log", "email", "reraise" }
  set SUPPRESS_REASONS = { "rate_limit_hourly", "rate_limit_dedup" }

  type JSErrorPayload = {
    message: str
    source: str
    lineno: int
    colno: int
  }

  type PythonExceptionPayload = {
    exception_type: str
    message: str
    tb_file: str
    tb_line: int
    tb_function: str
  }

  type ExceptionReport = {
    exception_type: str
    message: str
    severity: str
    environment: str
    file: str
    line: int
    function: str
    traceback: str
    context: dict<str, any>
    timestamp: str
  }

  type HandlerBehavior = {
    name: str
    order: int
  }

  type DedupKey = {
    exception_type: str
    file: str
    line: int
  }

  type Fault = {
    code: str
    message: str
    category: str
    results: list<any>
    detail: dict<str, any>
  }

  type Result = {
    ok: ExceptionReport
    err: Fault
  }

  fn classify_js_payload : (payload: JSErrorPayload, environment: str, timestamp: str) -> Result note "normalizes a browser error payload to an ExceptionReport, critical when the message says so, or a malformed_payload fault naming the missing keys"

  fn classify_py_payload : (payload: PythonExceptionPayload, environment: str, timestamp: str) -> Result note "normalizes a server exception payload to an ExceptionReport at error severity, or a malformed_payload fault naming the missing keys"

  fn should_bypass_dedup : (severity: str) -> bool note "tells whether a severity skips the throttle; only critical does"

  fn behaviors_for : (environment: str) -> list<HandlerBehavior> note "looks up the ordered behaviors for an environment, falling back to the development policy for an unknown one"

  fn dedup_key : (report: ExceptionReport) -> DedupKey note "takes the throttle's identity for a report: its exception type, file and line"

  fn new_state : () -> dict<str, any> note "builds an empty throttle state with no dedup entries and no recorded sends"

  fn check_rate_limit : (key: DedupKey, config: dict<str, any>, state: dict<str, any>, now: int) -> dict<str, any> note "decides whether a send may go out and returns the decision with the next state, suppressing for the hourly cap or a recent duplicate and never changing the state it was given"

  fn format_email_body : (report: ExceptionReport) -> str note "renders a report as a plain-text email body, cutting the context to its first ten entries"
