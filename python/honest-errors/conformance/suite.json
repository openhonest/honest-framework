  {
   "id": "dedupkey-projects",
   "kind": "dedupkey",
   "report": {
    "exception_type": "ValueError",
    "message": "bad value",
    "severity": "error",
    "environment": "production",
    "file": "app.py",
    "line": 10,
    "function": "handle",
    "traceback": "tb",
    "context": {},
    "timestamp": "2026-01-01T00:00:00Z"
   },
   "expect": {
    "exception_type": "ValueError",
    "file": "app.py",
    "line": 10
   }
  },
  {
   "id": "newstate-empty",
   "kind": "newstate"
  },
  {
   "id": "ratelimit-allow-empty",
   "kind": "ratelimit",
   "key": {
    "exception_type": "ValueError",
    "file": "app.py",
    "line": 10
   },
   "config": {
    "dedup_window_seconds": 300,
    "max_per_hour": 10
   },
   "state": {
    "dedup_cache": {},
    "hourly_sends": []
   },
   "now": 1000,
   "expect_should_send": true,
   "expect_reason": null,
   "expect_next_hourly": [
    1000
   ],
   "expect_cache_size": 1
  },
  {
   "id": "ratelimit-hourly-cap",
   "kind": "ratelimit",
   "key": {
    "exception_type": "ValueError",
    "file": "app.py",
    "line": 10
   },
   "config": {
    "dedup_window_seconds": 300,
    "max_per_hour": 2
   },
   "state": {
    "dedup_cache": {},
    "hourly_sends": [
     800,
     900
    ]
   },
   "now": 1000,
   "expect_should_send": false,
   "expect_reason": "rate_limit_hourly"
  },
