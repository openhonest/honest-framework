{
 "version": "0.2",
 "module": "honest-errors",
 "cases": [
  {
   "id": "vocab-severities",
   "kind": "vocab",
   "vocab": "SEVERITIES",
   "expect_members": [
    "debug",
    "info",
    "warning",
    "error",
    "critical"
   ]
  },
  {
   "id": "vocab-environments",
   "kind": "vocab",
   "vocab": "ENVIRONMENTS",
   "expect_members": [
    "development",
    "production",
    "test"
   ]
  },
  {
   "id": "vocab-behavior-names",
   "kind": "vocab",
   "vocab": "BEHAVIOR_NAMES",
   "expect_members": [
    "log",
    "email"
   ]
  },
  {
