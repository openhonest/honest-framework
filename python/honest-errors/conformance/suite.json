   "expect_names": [
    "js_severity",
    "classify_js_payload",
    "classify_py_payload",
    "should_bypass_dedup",
    "behaviors_for",
    "dedup_key",
    "new_state",
    "check_rate_limit",
    "format_email_body",
    "handle_failure",
    "capture",
    "SEVERITIES",
    "ENVIRONMENTS",
    "BEHAVIOR_NAMES",
    "SUPPRESS_REASONS"
   ]
  },
  {
   "id": "jsseverity-prefix-critical",
   "kind": "jsseverity",
   "message": "Critical: boom",
   "expect": "critical"
  },
  {
   "id": "jsseverity-upper-critical",
   "kind": "jsseverity",
   "message": "CRITICAL",
   "expect": "critical"
  },
  {
   "id": "jsseverity-substring-critical",
   "kind": "jsseverity",
   "message": "it was critical here",
   "expect": "critical"
  },
  {
   "id": "jsseverity-plain-error",
   "kind": "jsseverity",
   "message": "boom",
   "expect": "error"
  },
  {
   "id": "jsseverity-empty-error",
   "kind": "jsseverity",
   "message": "",
   "expect": "error"
  },
  {
   "id": "js-valid-error",
   "kind": "jsclassify",
   "payload": {
    "message": "undefined is not a function",
    "source": "https://app.example/x.js",
    "lineno": 42,
    "colno": 7,
    "stack": "Error\n  at f (x.js:42:7)",
    "url": "https://app.example/page",
    "user_agent": "Mozilla/5.0",
    "timestamp": "2026-01-01T00:00:00Z",
    "context": {}
   },
   "environment": "production",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "ok",
   "expect_severity": "error",
   "expect_message": "undefined is not a function"
  },
