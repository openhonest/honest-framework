{
 "version": "0.1",
 "module": "honest-errors",
 "cases": [
  {
   "id": "vocab-severities",
   "kind": "vocab",
   "vocab": "SEVERITIES",
   "expect_members": ["debug", "info", "warning", "error", "critical"]
  },
  {
   "id": "vocab-environments",
   "kind": "vocab",
   "vocab": "ENVIRONMENTS",
   "expect_members": ["development", "production", "test"]
  },
  {
   "id": "vocab-behavior-names",
   "kind": "vocab",
   "vocab": "BEHAVIOR_NAMES",
   "expect_members": ["log", "email"]
  },
  {
   "id": "vocab-suppress-reasons",
   "kind": "vocab",
   "vocab": "SUPPRESS_REASONS",
   "expect_members": ["rate_limit_hourly", "rate_limit_dedup"]
  },
  {
   "id": "exports-public-surface",
   "kind": "exports",
   "expect_names": [
    "classify_js_payload", "classify_py_payload", "should_bypass_dedup",
    "behaviors_for", "dedup_key", "new_state", "check_rate_limit", "format_email_body",
    "SEVERITIES", "ENVIRONMENTS", "BEHAVIOR_NAMES", "SUPPRESS_REASONS"
   ]
  },
  {
   "id": "js-valid-error",
   "kind": "jsclassify",
   "payload": {
    "message": "undefined is not a function",
    "source": "https://app.example/x.js",
    "lineno": 42,
    "colno": 7,
    "stack": "Error\n  at f (x.js:42:7)",
    "url": "https://app.example/page",
    "user_agent": "Mozilla/5.0",
    "timestamp": "2026-01-01T00:00:00Z",
    "context": {}
   },
   "environment": "production",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "ok",
   "expect_severity": "error",
   "expect_message": "undefined is not a function"
  },
  {
   "id": "js-valid-critical",
   "kind": "jsclassify",
   "payload": {
    "message": "Critical: heap corruption detected",
    "source": "https://app.example/x.js",
    "lineno": 5,
    "colno": 1,
    "stack": "Error\n  at g (x.js:5:1)",
    "url": "https://app.example/page",
    "user_agent": "Mozilla/5.0",
    "timestamp": "2026-01-01T00:00:00Z",
    "context": {}
   },
   "environment": "development",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "ok",
   "expect_severity": "critical"
  },
  {
   "id": "js-missing-message",
   "kind": "jsclassify",
   "payload": {
    "source": "https://app.example/x.js",
    "lineno": 42,
    "colno": 7,
    "stack": "Error",
    "url": "https://app.example/page",
    "user_agent": "Mozilla/5.0",
    "timestamp": "2026-01-01T00:00:00Z",
    "context": {}
   },
   "environment": "production",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "err",
   "expect_code": "malformed_payload"
  },
  {
   "id": "js-missing-stack",
   "kind": "jsclassify",
   "payload": {
    "message": "x",
    "source": "https://app.example/x.js",
    "lineno": 42,
    "colno": 7,
    "url": "https://app.example/page",
    "user_agent": "Mozilla/5.0",
    "timestamp": "2026-01-01T00:00:00Z",
    "context": {}
   },
   "environment": "production",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "err",
   "expect_code": "malformed_payload"
  },
  {
   "id": "py-valid-error",
   "kind": "pyclassify",
   "payload": {
    "exception_type": "ValueError",
    "message": "bad value",
    "tb_file": "app.py",
    "tb_line": 10,
    "tb_function": "handle",
    "traceback": "Traceback (most recent call last):\n  ValueError: bad value",
    "context": {}
   },
   "environment": "production",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "ok",
   "expect_severity": "error",
   "expect_message": "bad value",
   "expect_exception_type": "ValueError"
  },
  {
   "id": "py-missing-exception-type",
   "kind": "pyclassify",
   "payload": {
    "message": "bad value",
    "tb_file": "app.py",
    "tb_line": 10,
    "tb_function": "handle",
    "traceback": "tb",
    "context": {}
   },
   "environment": "production",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "err",
   "expect_code": "malformed_payload"
  },
  {
   "id": "py-missing-traceback",
   "kind": "pyclassify",
   "payload": {
    "exception_type": "ValueError",
    "message": "bad value",
    "tb_file": "app.py",
    "tb_line": 10,
    "tb_function": "handle",
    "context": {}
   },
   "environment": "production",
   "timestamp": "2026-02-02T12:00:00Z",
   "expect": "err",
   "expect_code": "malformed_payload"
  },
  {
   "id": "bypass-critical-true",
   "kind": "bypass",
   "severity": "critical",
   "expect": true
  },
  {
   "id": "bypass-error-false",
   "kind": "bypass",
   "severity": "error",
   "expect": false
  },
  {
   "id": "bypass-warning-false",
   "kind": "bypass",
   "severity": "warning",
   "expect": false
  },
  {
   "id": "behaviors-development",
   "kind": "behaviors",
   "environment": "development",
   "expect": "ok",
   "expect_list": [{"name": "log", "order": 0}]
  },
  {
   "id": "behaviors-production",
   "kind": "behaviors",
   "environment": "production",
   "expect": "ok",
   "expect_list": [{"name": "log", "order": 0}, {"name": "email", "order": 1}]
  },
  {
   "id": "behaviors-test",
   "kind": "behaviors",
   "environment": "test",
   "expect": "ok",
   "expect_list": [{"name": "log", "order": 0}]
  },
  {
   "id": "behaviors-unknown",
   "kind": "behaviors",
   "environment": "staging",
   "expect": "err",
   "expect_code": "unknown_environment"
  },
  {
   "id": "dedupkey-projects",
   "kind": "dedupkey",
   "report": {
    "exception_type": "ValueError",
    "message": "bad value",
    "severity": "error",
    "environment": "production",
    "file": "app.py",
    "line": 10,
    "function": "handle",
    "traceback": "tb",
    "context": {},
    "timestamp": "2026-01-01T00:00:00Z"
   },
   "expect": {"exception_type": "ValueError", "file": "app.py", "line": 10}
  },
  {
   "id": "newstate-empty",
   "kind": "newstate"
  },
  {
   "id": "ratelimit-allow-empty",
   "kind": "ratelimit",
   "key": {"exception_type": "ValueError", "file": "app.py", "line": 10},
   "config": {"dedup_window_seconds": 300, "max_per_hour": 10},
   "state": {"dedup_cache": {}, "hourly_sends": []},
   "now": 1000,
   "expect_should_send": true,
   "expect_reason": "",
   "expect_next_hourly": [1000],
   "expect_cache_size": 1
  },
  {
   "id": "ratelimit-hourly-cap",
   "kind": "ratelimit",
   "key": {"exception_type": "ValueError", "file": "app.py", "line": 10},
   "config": {"dedup_window_seconds": 300, "max_per_hour": 2},
   "state": {"dedup_cache": {}, "hourly_sends": [800, 900]},
   "now": 1000,
   "expect_should_send": false,
   "expect_reason": "rate_limit_hourly"
  },
  {
   "id": "emailbody-contains",
   "kind": "emailbody",
   "report": {
    "exception_type": "ValueError",
    "message": "bad value",
    "severity": "error",
    "environment": "production",
    "file": "app.py",
    "line": 10,
    "function": "handle",
    "traceback": "Traceback: ValueError",
    "context": {},
    "timestamp": "2026-01-01T00:00:00Z"
   },
   "expect_contains": ["ValueError", "bad value", "error", "production"]
  }
 ]
}
