{
  "version": "0.3",
  "module": "honest-errors",
  "note": "The error-cadence pure core (spec v0.2, sections 2-5). Representation-dependent behaviour (presets, resolve pass-through, build_response, cadence-state transitions) is asserted in laws_he.py. The orchestrator, door, and persistence functions are parked until persistence is wired.",
  "cases": [
    { "id": "vocab-severities", "kind": "vocab", "vocab": "SEVERITIES",
      "expect_members": ["debug", "info", "warning", "error", "critical"] },
    { "id": "vocab-environments", "kind": "vocab", "vocab": "ENVIRONMENTS",
      "expect_members": ["development", "production", "test"] },
    { "id": "vocab-response-modes", "kind": "vocab", "vocab": "RESPONSE_MODES",
      "expect_members": ["returned", "acknowledged"] },
    { "id": "vocab-payload-sources", "kind": "vocab", "vocab": "PAYLOAD_SOURCES",
      "expect_members": ["js", "py"] },
    { "id": "vocab-preset-names", "kind": "vocab", "vocab": "PRESET_NAMES",
      "expect_members": ["silent", "acknowledge", "report_back", "notify"] },
    { "id": "vocab-action-kinds", "kind": "vocab", "vocab": "ACTION_KINDS",
      "expect_members": ["show", "hide", "send"] },
    { "id": "vocab-display-statuses", "kind": "vocab", "vocab": "DISPLAY_STATUSES",
      "expect_members": ["showing", "pending"] },
    { "id": "vocab-duration-kinds", "kind": "vocab", "vocab": "DURATION_KINDS",
      "expect_members": ["once", "period"] },
    { "id": "vocab-timing-kinds", "kind": "vocab", "vocab": "TIMING_KINDS",
      "expect_members": ["immediate", "scheduled"] },
    { "id": "vocab-fault-codes", "kind": "vocab", "vocab": "FAULT_CODES",
      "expect_members": ["malformed_payload", "unknown_source", "unknown_preset"] },

    { "id": "exports-pure-surface", "kind": "exports",
      "expect_names": ["js_severity", "classify_js_payload", "classify_py_payload", "normalize",
        "preset_silent", "preset_acknowledge", "preset_report_back", "preset_notify",
        "resolve_cadence", "build_response", "dedup_key",
        "expire_elapsed", "release_due", "add_display", "advance_cadence",
        "SEVERITIES", "ENVIRONMENTS", "RESPONSE_MODES", "PAYLOAD_SOURCES", "PRESET_NAMES",
        "ACTION_KINDS", "DISPLAY_STATUSES", "DURATION_KINDS", "TIMING_KINDS", "FAULT_CODES"] },

    { "id": "jsseverity-critical-token", "kind": "jsseverity", "message": "the widget went critical", "expect": "critical" },
    { "id": "jsseverity-critical-mixed-case", "kind": "jsseverity", "message": "CRITICAL meltdown", "expect": "critical" },
    { "id": "jsseverity-plain-error", "kind": "jsseverity", "message": "undefined is not a function", "expect": "error" },
    { "id": "jsseverity-empty", "kind": "jsseverity", "message": "", "expect": "error" },

    { "id": "jsclassify-ok-critical", "kind": "jsclassify",
      "payload": { "message": "render went critical", "source": "app.js", "lineno": 42, "colno": 7,
        "stack": "at render (app.js:42:7)", "url": "https://example.test/app", "user_agent": "UA/1.0",
        "timestamp": "2026-11-15T11:59:00Z", "context": { "widget": "chart" } },
      "environment": "production", "timestamp": "2026-11-15T12:00:00Z",
      "expect_severity": "critical", "expect_message": "render went critical",
      "expect_exception_type": "Error" },
    { "id": "jsclassify-malformed-missing-message", "kind": "jsclassify",
      "payload": { "source": "app.js", "lineno": 42, "colno": 7, "stack": "", "url": "https://example.test/app",
        "user_agent": "UA/1.0", "timestamp": "2026-11-15T11:59:00Z", "context": {} },
      "environment": "production", "timestamp": "2026-11-15T12:00:00Z",
      "expect": "err", "expect_code": "malformed_payload" },

    { "id": "pyclassify-ok", "kind": "pyclassify",
      "payload": { "exception_type": "ValueError", "message": "bad literal", "tb_file": "svc.py",
        "tb_line": 88, "tb_function": "parse", "traceback": "Traceback ...", "context": { "input": "x" } },
      "environment": "development", "timestamp": "2026-11-15T12:00:00Z",
      "expect_severity": "error", "expect_exception_type": "ValueError", "expect_message": "bad literal" },
    { "id": "pyclassify-malformed-missing-exception-type", "kind": "pyclassify",
      "payload": { "message": "bad literal", "tb_file": "svc.py", "tb_line": 88, "tb_function": "parse",
        "traceback": "Traceback ...", "context": {} },
      "environment": "development", "timestamp": "2026-11-15T12:00:00Z",
      "expect": "err", "expect_code": "malformed_payload" },

    { "id": "normalize-js", "kind": "normalize", "source": "js",
      "payload": { "message": "render went critical", "source": "app.js", "lineno": 42, "colno": 7,
        "stack": "at render (app.js:42:7)", "url": "https://example.test/app", "user_agent": "UA/1.0",
        "timestamp": "2026-11-15T11:59:00Z", "context": {} },
      "environment": "production", "timestamp": "2026-11-15T12:00:00Z",
      "expect_severity": "critical", "expect_message": "render went critical" },
    { "id": "normalize-py", "kind": "normalize", "source": "py",
      "payload": { "exception_type": "ValueError", "message": "bad literal", "tb_file": "svc.py",
        "tb_line": 88, "tb_function": "parse", "traceback": "Traceback ...", "context": {} },
      "environment": "development", "timestamp": "2026-11-15T12:00:00Z",
      "expect_severity": "error", "expect_exception_type": "ValueError", "expect_message": "bad literal" },
    { "id": "normalize-unknown-source", "kind": "normalize", "source": "ruby",
      "payload": { "message": "x" }, "environment": "production", "timestamp": "2026-11-15T12:00:00Z",
      "expect": "err", "expect_code": "unknown_source" },

    { "id": "dedupkey-identity", "kind": "dedupkey",
      "report": { "exception_type": "ValueError", "message": "bad literal", "severity": "error",
        "environment": "development", "file": "svc.py", "line": 88, "function": "parse",
        "traceback": "Traceback ...", "context": {}, "timestamp": "2026-11-15T12:00:00Z" },
      "expect": { "exception_type": "ValueError", "file": "svc.py", "line": 88 } },

    { "id": "resolve-unknown-preset", "kind": "resolve_fault", "arg": "stampede",
      "expect_code": "unknown_preset" }
  ]
}
