  {"id": "value-apply-projection-empty", "value_case": {"function": "apply_projection", "args": [{"projection_id": "placed_only", "event_types": ["order.placed"]}, [], {"$ref": "count_fold"}, 0], "expected": 0}},
  {"id": "value-apply-projection-seeded", "value_case": {"function": "apply_projection", "args": [{"projection_id": "placed_only", "event_types": ["order.placed"]}, [{"event_type": "order.placed"}, {"event_type": "order.placed"}], {"$ref": "count_fold"}, 2], "expected": 4}}
 ]
