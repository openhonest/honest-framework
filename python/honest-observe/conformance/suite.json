  {"id": "value-build-event-ok", "value_case": {"function": "build_event", "args": ["order.placed", "1.0", "order", "ord-1", {"total": 10}, {"caller_id": "u1"}, {"release": "r1"}, "eid-1", "2026-01-01T00:00:00.000000Z", 1], "expected": {"event_id": "eid-1", "event_type": "order.placed", "event_version": "1.0", "timestamp": "2026-01-01T00:00:00.000000Z", "sequence": 1, "aggregate_type": "order", "aggregate_id": "ord-1", "payload": {"total": 10}, "auth": {"caller_id": "u1"}, "meta": {"release": "r1"}}}},

  {"id": "value-matches-hit", "value_case": {"function": "matches", "args": [{"event_type": "order.placed"}, ["order.placed", "order.shipped"]], "expected": true}},
  {"id": "value-matches-miss", "value_case": {"function": "matches", "args": [{"event_type": "order.cancelled"}, ["order.placed", "order.shipped"]], "expected": false}},
  {"id": "value-matches-empty", "value_case": {"function": "matches", "args": [{"event_type": "order.placed"}, []], "expected": false}},

