# honest-estimate declared in .hd — deductive SIZE from the .hd contract boundary. The three size
# readings of §6.1 (COSMIC CFP, VFP breadth, and bits of case-distinction) are read off the declaration,
# before code exists. Pure over the IR; read_hd is the one (pure) boundary.

module honest-estimate

  layer tooling

  type Vfp = {
    total: int
    ifpug_countable: int
    beyond_ifpug_internal: int
    internal_share_ratio: float
    under_declared: bool
  }

  type OpenFlag = {
    process: str
    param: str
    type: str
  }

  type Depth = {
    bits: float
    open_flags: list<OpenFlag>
  }

  type SizeReport = {
    cosmic_cfp: int
    vfp: Vfp
    bits_of_case_distinction: float
    open_vocab_flags: list<OpenFlag>
    cfp_certified: bool
  }

  fn elementary_processes : (module: dict<str, any>) -> list<str>

  fn vfp : (module: dict<str, any>) -> Vfp

  fn cfp : (module: dict<str, any>) -> int

  fn depth : (module: dict<str, any>) -> Depth

  fn size : (source: str) -> SizeReport

  fn quality : (mutants_total: int, mutants_equivalent: int, escaped_defects: int, process_count: int) -> dict<str, any>

  fn cost : (cosmic_cfp: int, rate_model: dict<str, any>) -> dict<str, any>

  fn duration : (cosmic_cfp: int, rate_model: dict<str, any>) -> dict<str, any>

  fn jones : (native: dict<str, any>, jones_constants: dict<str, any>) -> dict<str, any>

  fn estimate : (source: str, rate_model: dict<str, any>, jones_constants: dict<str, any>, build_inputs: dict<str, any>) -> dict<str, any>
