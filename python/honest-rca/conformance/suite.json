   "expect_nodes": ["a", "b"],
   "expect_edges": [["a", "b", "dataflow", false], ["a", "b", "judgment", true]]
  },
  {
   "id": "trace-chain-upstream",
   "kind": "trace",
   "graph": {
    "nodes": ["a", "b", "c"],
    "edges": [
     {"cause": "a", "effect": "b", "signal": "dataflow", "marked": false},
     {"cause": "b", "effect": "c", "signal": "dataflow", "marked": false}
    ]
   },
   "symptom": {"id": "s", "description": "fails at c", "site": "c"},
   "expect_chain": ["c", "b", "a"]
  },
  {
   "id": "trace-no-upstream-is-site-alone",
   "kind": "trace",
   "graph": {
    "nodes": ["a", "b"],
    "edges": [{"cause": "a", "effect": "b", "signal": "dataflow", "marked": false}]
   },
   "symptom": {"id": "s", "description": "fails at a", "site": "a"},
   "expect_chain": ["a"]
  },
  {
   "id": "terminus-last-of-chain",
   "kind": "terminus",
   "chain": ["c", "b", "a"],
   "expect": "a"
  },
  {
   "id": "terminus-site-alone",
   "kind": "terminus",
   "chain": ["x"],
   "expect": "x"
  },
  {
