   "expect_nodes": ["a", "b"],
   "expect_edges": [["a", "b", "dataflow", false]]
  },
  {
   "id": "causal-graph-judgment-enabled-included",
   "kind": "causal_graph",
   "items": [
    {"id": "a", "kind": "code", "ref": "ra", "flows_to": ["b"], "controls": [], "changed_with": [], "precedes": [], "category": ""},
    {"id": "b", "kind": "code", "ref": "rb", "flows_to": [], "controls": [], "changed_with": [], "precedes": [], "category": ""}
   ],
   "method": {"version": "v1", "signals": ["dataflow", "judgment"], "traversal": "upstream"},
