   "kind": "causal_graph",
   "items": [
    {"id": "a", "kind": "code", "ref": "ra", "flows_to": ["b"], "controls": ["b"], "changed_with": [], "precedes": [], "category": ""},
    {"id": "b", "kind": "code", "ref": "rb", "flows_to": [], "controls": [], "changed_with": [], "precedes": [], "category": ""}
