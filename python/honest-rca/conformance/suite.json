    {"id": "a", "kind": "code", "ref": "ra", "flows_to": [], "controls": [], "changed_with": [], "precedes": [], "category": "missing_invariant"},
    {"id": "c", "kind": "code", "ref": "rc", "flows_to": [], "controls": [], "changed_with": [], "precedes": [], "category": ""}
