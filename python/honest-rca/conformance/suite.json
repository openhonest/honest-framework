{
 "version": "0.1",
 "module": "honest-rca",
 "cases": [
  {
   "id": "vocab-evidence-kinds",
   "kind": "vocab",
   "vocab": "EVIDENCE_KINDS",
   "expect_members": ["code", "event", "history", "config", "deploy"]
  },
  {
   "id": "vocab-signal-kinds",
   "kind": "vocab",
   "vocab": "SIGNAL_KINDS",
   "expect_members": ["dataflow", "controlflow", "change_correlation", "temporal", "judgment"]
  },
  {
   "id": "vocab-bound-kinds",
   "kind": "vocab",
   "vocab": "BOUND_KINDS",
   "expect_members": ["outside_evidence", "invisible_to_method"]
  },
  {
   "id": "exports-public-surface",
   "kind": "exports",
   "expect_names": [
    "evidence_hash", "evidence_set", "signal_edges", "causal_graph", "trace",
    "terminus", "bound", "attest", "validate_attestation", "terminus_is_design_root",
    "EVIDENCE_KINDS", "SIGNAL_KINDS", "BOUND_KINDS"
   ]
  },
  {
   "id": "evidence-set-stamps-hash",
   "kind": "evidence_set",
   "items": [
    {"id": "a", "kind": "code", "ref": "ra", "flows_to": ["b"], "controls": [], "changed_with": [], "precedes": [], "category": ""},
    {"id": "b", "kind": "event", "ref": "rb", "flows_to": [], "controls": [], "changed_with": [], "precedes": [], "category": ""}
   ]
  },
  {
   "id": "relation-flows-to",
   "kind": "relation",
   "fn": "relation_flows_to",
   "item": {"id": "a", "kind": "code", "ref": "ra", "flows_to": ["b", "c"], "controls": [], "changed_with": [], "precedes": [], "category": ""},
   "expect": ["b", "c"]
  },
  {
   "id": "relation-controls",
   "kind": "relation",
   "fn": "relation_controls",
   "item": {"id": "a", "kind": "code", "ref": "ra", "flows_to": [], "controls": ["d"], "changed_with": [], "precedes": [], "category": ""},
   "expect": ["d"]
  },
  {
   "id": "relation-changed-with",
   "kind": "relation",
   "fn": "relation_changed_with",
   "item": {"id": "a", "kind": "history", "ref": "ra", "flows_to": [], "controls": [], "changed_with": ["e"], "precedes": [], "category": ""},
   "expect": ["e"]
  },
  {
   "id": "relation-precedes",
   "kind": "relation",
   "fn": "relation_precedes",
   "item": {"id": "a", "kind": "event", "ref": "ra", "flows_to": [], "controls": [], "changed_with": [], "precedes": ["f"], "category": ""},
   "expect": ["f"]
  },
  {
   "id": "relation-absent-is-empty",
   "kind": "relation",
   "fn": "relation_flows_to",
   "item": {"id": "a", "kind": "code", "ref": "ra", "flows_to": [], "controls": ["d"], "changed_with": [], "precedes": [], "category": ""},
   "expect": []
