# honest-features declared in .hd — the feature-flag subsystem: a static flag vocabulary, flag state
# threaded as a value, and an HMAC-signed toggle. All pure; the HTTP route is the application's
# integration boundary, not part of this module.

module honest-features

  layer domain

  type FlagVocabulary = {
    flags: dict<str, any>
  }

  type FlagState = {
    states: dict<str, str>
  }

  type Fault = {
    code: str
    message: str
    category: str
    results: list<any>
    detail: dict<str, any>
  }

  type Result = {
    ok: any
    err: Fault
  }

  type Event = {
    event_type: str
    payload: dict<str, any>
  }

  fn validate_vocabulary : (features: FlagVocabulary) -> list<Fault> note "validates the FEATURES flag vocabulary against the §2.1 vocabulary rules and returns one Fault per rule a flag entry breaks, the empty list when the vocabulary is well-formed. features is the whole flag vocabulary, the FlagVocabulary whose flags map goes from each flag name to that flag's spec dict. §2.1 requires every entry to declare exactly two keys — states, the complete set of valid states for the flag, which must contain at least two members, and initial_value, the startup state, which must be a member of states — and permits no other key at the vocabulary level, because metadata (owner, description, created date) belongs in a separate registry outside the runtime vocabulary. It returns a list of Fault records, one per violation it finds: a flag whose states set has fewer than two members, a flag whose initial_value is not a member of its own states set, or a flag carrying a key other than states and initial_value. An empty list means every flag entry obeys the §2.1 rules (§2.1, §10.2). It is a pure function over the vocabulary value: it reads no file, no environment variable and no clock, and it returns the faults as data rather than raising. It is not a boundary; the application declares the vocabulary and passes it in."

  fn initial_state : (features: FlagVocabulary) -> FlagState note "builds the flag state value held at process startup, each flag set to its declared initial_value (§3, §3.1). features is the whole flag vocabulary; initial_state reads each flag's spec and copies its initial_value, the startup state §2.1 requires to be a member of the flag's states set. It returns a FlagState whose states map goes from each flag name to that flag's initial state. It reads no environment variable, no config file and no database — initialization is deterministic and needs no I/O (§3.1) — so it is a pure function the application calls exactly once at startup and then holds the returned value. Because there is no persistence (§3.2), a restarted process always starts from these declared initial values, a known state. The value is threaded, not a module global, which is what keeps feature_state a pure lookup and lets the module pass its own gate. It is not a boundary. It is also the one reader of each flag's initial_value: §2.1 states the startup value is read exactly once, by initial_state, and is never a runtime fallback."

  fn feature_state : (state: FlagState, flag: str) -> str note "the current state of one flag, read from the state value (§3). state is the held FlagState the application threads in; flag is the flag name to read. It returns the flag's current state as a str, which §2.2 guarantees is a member of that flag's declared states set, so a downstream handler table always has a handler for the value it returns. A flag not declared in FEATURES is a programming error caught statically by rule HF001 (§7), so a flag that reaches here is always present; an undeclared flag raises KeyError at lookup rather than returning a silent default (§3, §10.2), which is intentional. It is the only interface downstream code uses to read flag state, and all feature branching dispatches on its return through a handler table, never through if/else (§4). It is a pure lookup over the state value it is handed: no I/O, no side effect, no module global (§3). It is not a boundary."

  fn validate_toggle : (features: FlagVocabulary, flag: str, state: str) -> Result note "validates one requested toggle against the vocabulary and returns the result as data, the §5.1 400-condition check the toggle route runs before it touches state (§5, §5.3). features is the flag vocabulary; flag is the requested flag name; state is the requested new state. It returns a Result: the ok arm when flag is a declared key in FEATURES and state is a member of FEATURES[flag]['states'], and the err arm carrying a Fault when the flag is not declared in FEATURES or the state is not a member of that flag's declared states set — the two 400 conditions of §5.1. The route raises HTTPException 400 with the fault's message when the err arm is present, before any signature check (§5.3). It is a pure function over the vocabulary value: it reads no world and returns the outcome as data rather than raising. It is not a boundary."

  fn apply_toggle : (current: FlagState, flag: str, new: str) -> FlagState note "applies one validated toggle to the held state value and returns the updated state, the single mutation the toggle endpoint makes to flag state (§3, §5.3). current is the held FlagState before the change; flag is the flag to set; new is its new state, already checked by validate_toggle and verify_signature upstream. It returns a FlagState equal to current with that one flag set to new and every other flag carried unchanged — the new value the route stores back as the application's held state, the single mutator of the 'dynamic config' kind §3 names. It is a pure function over the state value: it builds and returns a new value rather than mutating current in place, reads no world, and holds no module global, which is what keeps the toggle a value threaded through the boundary rather than hidden state. It is not a boundary."

  fn build_signature : (secret: bytes, flag: str, state: str, timestamp: int) -> str note "computes the HMAC-SHA256 signature over a toggle message, the caller-side signing of §5.2. secret is the shared HMAC secret as raw bytes, loaded from a configuration record at the boundary and never hardcoded nor read from an environment variable (§5.4); flag, state and timestamp are the toggle's fields being signed. It builds the message '{flag}:{state}:{timestamp}', UTF-8 encoded, and returns its HMAC-SHA256 hexdigest as a str, the signature the caller sends with the toggle request (§5.1). Signing flag, state and timestamp together is what makes a tampered request body invalidate the signature; the shared secret never travels over the wire (§5.2). It is a pure function: given the same inputs it returns the same digest, reads no clock and touches no world. It is not a boundary."

  fn verify_signature : (secret: bytes, flag: str, state: str, timestamp: int, signature: str, now: int, window: int) -> bool note "verifies a toggle request's HMAC signature and its replay window, the server-side check of §5.2. secret is the shared HMAC secret as bytes; flag, state and timestamp are the signed fields; signature is the hexdigest the caller sent. now is the current Unix time, passed in because reading the clock is I/O and belongs at the boundary, so verify_signature stays a pure function the tests can drive at any instant. window is the replay tolerance in seconds and is a required parameter with no default: a replay tolerance is a security decision the caller must make explicitly, and a default would let a caller accept a window it never chose while hiding whether it chose or forgot (HC-P015), so the boundary resolves window from configuration, commonly 60 seconds, and passes it in. It returns False when abs(now - timestamp) is greater than window — the timestamp is outside the replay window (§5.1, a 403 at the route) — and otherwise recomputes the expected HMAC-SHA256 over '{flag}:{state}:{timestamp}' and returns hmac.compare_digest(expected, signature), the constant-time comparison §5.2 requires because ordinary string equality is vulnerable to a timing attack. It returns True only when the window holds and the recomputed signature matches the one supplied. It is pure: now and window are passed in, so it reads no clock and touches no world. It is not a boundary."

  fn changed_event : (flag: str, previous: str, state: str, timestamp: int, requesting_ip: str) -> Event note "builds the state-change event the toggle endpoint emits after a successful toggle (§8.1). flag is the flag that changed; previous is its state before the change; state is its new state; timestamp is the toggle's timestamp; requesting_ip is the client IP the route reads off the request. It returns an Event whose event_type is 'hf.features.changed' and whose payload carries flag, previous, state, timestamp and requesting_ip, exactly the record §8.1 shows. It only assembles the event record; the route emits it to the honest-observe event log synchronously after the state change (§8, §8.1) — honest-features emits, honest-observe owns the log. It is a pure function that reads no world and returns the event as data. It is not a boundary."

  fn evaluated_event : (flag: str, state: str, request_id: str) -> Event note "builds the flag-evaluation event emitted when a flag is read inside a request context (§8.2). flag is the flag that was evaluated; state is the state it held at evaluation; request_id is the current request's id, available in the request context. It returns an Event whose event_type is 'hf.features.evaluated' and whose payload carries flag, state and request_id, exactly the record §8.2 shows. The event is emitted only within a request context — not outside one, to avoid noise in background tasks — and lets operators correlate flag states with request outcomes in the unified event log (§8.2). It only assembles the event record; honest-observe owns the log. It is a pure function that reads no world and returns the event as data. It is not a boundary."

  # ======================================================================================
  # How the world arrives. honest-features is a pure library: it declares no door. Every
  # exported function is reached by import — the application's toggle route imports the toggle
  # and signature functions, startup imports initial_state, downstream code imports feature_state,
  # and tests import initial_state (§5.3, §6, §11). So each function carries its own import entry
  # naming that it is called from outside the module.
  # ======================================================================================
  entry "import honest_features" -> validate_vocabulary
  entry "import honest_features" -> initial_state
  entry "import honest_features" -> feature_state
  entry "import honest_features" -> validate_toggle
  entry "import honest_features" -> apply_toggle
  entry "import honest_features" -> build_signature
  entry "import honest_features" -> verify_signature
  entry "import honest_features" -> changed_event
  entry "import honest_features" -> evaluated_event
