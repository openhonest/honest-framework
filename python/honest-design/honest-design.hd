# honest-design declared in its own .hd — the read path declaring itself, the first dogfood of the
# .hd layer. Read it with read_hd, check it with validate, draw it with render.

module honest-design

  layer tooling

  # --- The Result shape and the IR the read path produces ------------------

  type Fault = {
    code: str
    message: str
    category: str
    detail: dict<str, str>
  }

  type Result = {
    ok: any
    err: Fault
  }

  type Env = {
    name: str
    type: list<any>
  }

  type Module = {
    name: str
    layer: str
    envs: list<Env>
    types: list<any>
    functions: list<any>
    chains: list<any>
  }

  type Document = {
    modules: list<Module>
    rules: list<any>
    actors: list<any>
    flows: list<any>
  }

  type Diagram = {
    module: str
    columns: list<any>
    edges: list<any>
  }

  # --- The read path: pure functions over the parse tree -------------------

  fn read_hd : (source: str) -> Result

  fn _read_env : (node: any, source: bytes) -> Env
  fn _env_reads : (module: Module) -> list<any>
  fn _unknown_envs : (module: Module) -> list<Fault>
  fn _type_names : (parts: list<any>) -> set<str>
  fn _reaches_handle : (name: str, aliases: dict<str, any>, budget: int) -> bool
  fn _handles : (module: Module) -> set<str>
  fn _held_not_read : (module: Module) -> list<Fault>
  fn _can_fault : (module: Module) -> set<str>
  fn _callees : (module: Module) -> list<any>
  fn _fault_swallowed : (module: Module) -> list<Fault>
  fn _fault_shape : (module: Module) -> list<Fault>
  fn _door_called : (module: Module) -> list<Fault>
  fn _reader_calls : (module: Module) -> list<Fault>
  fn _read_surface_member : (node: any, source: bytes) -> SurfaceMember
  fn _read_surfaces : (node: any, source: bytes) -> Surfaces
  fn _bad_surfaces : (module: Module) -> list<Fault>
  fn validate : (module: Module) -> list<Fault>

  fn render : (module: Module) -> Diagram

  fn ok : (value: any) -> Result

  fn err : (failure: Fault) -> Result

  fn fault : (code: str, message: str, category: str, detail: dict<str, str>) -> Fault
