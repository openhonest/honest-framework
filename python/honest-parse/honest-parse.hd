# honest-parse declared in .hd — the framework's only parser. Written in the order the hd skill
# sets: the world first, then the path its door takes, then the types, then what the orchestrator
# pulls, then the pure functions it reaches.
# Architecture: ../../specs/02-code-quality/honest-parse-architecture.md

module honest-parse

  layer foundation

  # Step 1. The world, and nothing else is in it. Another module asks for a syntax tree; the
  # grammars live in tree-sitter. This module writes nothing anywhere: its answer travels back
  # through the door, and a return is not a write.
  inputs  = { "process:tree-sitter" : "the in-process parser library that owns every grammar" }
  outputs = { }

  # Step 3. The dictionary for the one path. A grammar name is a closed set of words, so it is a
  # vocabulary and never a str: the module carries ten grammars and no eleventh is sayable.
  set grammars = { "python", "javascript", "ruby", "php", "go", "elixir",
                   "html" : "the HTML and HTMX template grammar",
                   "jinja" : "the Jinja template grammar tree-sitter-html reads as opaque text",
                   "css" : "component stylesheets, for resolving a class to a rule",
                   "hd" : "the architecture declarations themselves" }
  vocabulary Language = { grammars }

  type GrammarHandle = foreign "tree-sitter" note "the resolved grammar object read from the immutable configured grammar table."

  type Tree = {
    root_node: Node
  }

  type Fault = {
    code: str
    message: str
    category: str
    detail: dict<str, any>
  }

  type ParseFailure = {
    err: Fault
  } note "the fault arm returned by the grammar lookup and the path-directed syntax check."

  type CheckedTree = {
    ok: Tree
  } note "the path-directed parser's successful result, which wraps the checked tree."

  type ChosenLanguage = {
    ok: Language
  } note "the language chooser's successful result, which wraps the selected grammar name."

  # Step 1, the cards. One per thing in the world, each a signature and a side effect and no more.

  boundary_in fn parse_source : (source: bytes, path: str) -> CheckedTree | ParseFailure invokes place_source note "the path-directed door. It hands the bytes and path to place_source unchanged."

  boundary_in fn parse_root_node : (source: bytes, language: str) -> Node | ParseFailure invokes read_root_node note "the grammar-directed inspection door. It hands the supplied bytes and explicit grammar name unchanged to read_root_node and returns the exact result."

  boundary_in fn parse : (source: bytes, language: str) -> Tree | ParseFailure invokes read_by_language note "the published grammar-directed parser. It hands the bytes and grammar name to read_by_language and returns its tree, including recovery nodes, or the unchanged fault."

  reader fn read_tree : (source: bytes, grammar: GrammarHandle) -> Tree side_effect reads "process:tree-sitter" note "make a new Parser using the resolved grammar, parse the supplied bytes, and return the original tree. This is the only tree-sitter operation."

  orchestrator fn read_by_language : (source: bytes, language: str) -> Tree | ParseFailure invokes grammar_for, read_tree note "resolve the grammar by name. Return its fault unchanged when the grammar is missing. Otherwise ask read_tree for the original parse tree, including recovery nodes."

  orchestrator fn place_source : (source: bytes, path: str) -> CheckedTree | ParseFailure invokes language_of, _pick, grammar_for, read_tree, _checked_tree note "look up the grammar name by suffix and resolve its handle. Preserve a lookup fault unchanged. Otherwise hand the tree returned by read_tree to _checked_tree for the path-specific verdict."

  orchestrator fn read_root_node : (source: bytes, language: str) -> Node | ParseFailure invokes grammar_for, read_tree, root_node_or_fault note "resolve the explicit grammar name. Give the grammar fault untouched or, when there is a resolved grammar, give the tree returned by read_tree to root_node_or_fault."

  fn grammar_for : (language: str) -> GrammarHandle | ParseFailure invokes _unknown_grammar note "lookup in the immutable grammar table. Return the matched handle or the existing unknown_grammar fault."

  fn root_node_or_fault : (result: Tree | ParseFailure) -> Node | ParseFailure note "extract the actual root from a returned tree, preserving ERROR and MISSING descendants. Pass an unknown_grammar fault through unchanged."

  chain place = parse_source -> place_source

  # Step 5. The pure functions that one orchestrator reaches.

  fn language_of : (path: str) -> ChosenLanguage | ParseFailure invokes _pick note "look up the grammar by path suffix or return the unplaceable_extension fault."

  fn _pick : (flag: any, when_true: Callable, when_false: Callable) -> any note "look up the selector for the truth value of flag. Invoke only the corresponding zero-argument thunk once and return its exact answer. Effects of a selected operation belong to the caller that supplies it."

  fn _unknown_grammar : (language: str) -> ParseFailure note "return the unknown_grammar server fault with the requested name and the sorted list of supported grammar names in the message."

  fn _checked_tree : (tree: Tree, path: str, language: str) -> CheckedTree | ParseFailure invokes _pick, _syntax_error note "wrap a clean tree in the ok arm. When its root contains a syntax error, return the located syntax_error fault for the same path and grammar."

  fn _syntax_error : (root: Node, path: str, language: str) -> ParseFailure pure_call "honest-parse-tree.first_error_node" pure_call "honest-parse-tree.line_col" note "locate the first ERROR or MISSING node in an erroneous root. Return the syntax_error client fault with the path, grammar and one-based line and column in the message, and path, line and col in the detail."

  entry "export honest_parse" -> parse_source
  entry "export honest_parse" -> parse
  entry "export honest_parse" -> parse_root_node
