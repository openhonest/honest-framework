# honest-test declared in .hd — the auto-generated verification layer of the framework (architecture:
# ../../specs/02-code-quality/honest-test-architecture.md). honest-test derives every test case from a
# module's own declarations — vocabularies, links, chains, state machines — and runs them; the developer
# writes no test code (spec section 1).
#
# Three doors, all boundary_in. The host starts a run two ways: the CLI `python -m honest_test [src_dir]`
# (run_cli), and the pytest plugin at collection time (check_test_body, section 4.8, which refuses a test
# body that rebinds a call target at runtime). A sibling module's conformance runner enters one engine by
# import: the value oracle (evaluate_case, section 8.6). The law runner has moved to honest-utilities
# (honest-utilities-architecture.md Appendix A, honest-test spec section 4.10); honest-test keeps only the
# generators that build the subjects a law runs against — the Set enumeration and the adversarial neighbors.
#
# On a CLI run four readers pull from the world — read_source reads each file under src/, read_config reads
# honest-test.toml, load_under_test imports each module for its live declarations, read_template reads the
# shipped step-library templates — and run_mutant_suite runs each mutant's conformance suite out of process
# under the memory-capped harness. One orchestrator (run_suite) drives the pure core: parse and classify
# predicates, generate the cases source analysis can produce, enumerate sets and adversarial neighbors over
# the live declarations, measure coverage, judge each mutant (classify_mutant_result), generate the chain
# scaffolding (generate_scaffolding), and build each proof event (build_proof_event). Four sinks write: the
# human report to stdout, coverage.json to the filesystem, the scaffolding files to the scaffolding directory
# (write_scaffolding), and each proof event through an injected honest-observe runtime (emit_proof_event,
# section 8.5). Generation and measurement are pure and return data — only the readers and the sinks touch
# the world.
#
# The value-oracle engine enters its own orchestrator and runs the caller's injected code at the boundary,
# which is the one thing honest-type never does and the reason honest-type is a pure library where this is
# an engine (section 8.6). evaluate_case hands to run_case, which resolves the suite case (resolve_call),
# runs the injected function under test at the boundary (run_resolved_call), and judges the output against
# the known-good value (compare_output).
#
# The §8.4 protocol-assertion step library and the §8.6 value-assertion step library are template files
# honest-test ships and an orchestrator reads (read_template), not functions in honest-test's own call graph;
# they are shipped source the adopter imports into its feature suite, never declared here (sections 8.4, 8.6).

module honest-test

  layer tooling

  note "the verification layer. The CLI and pytest collector run the suite and collection checks. Public source and runtime checks have their own doors, and the value oracle runs one portable case."

  # The surface, closed. honest-test reads the filesystem — the source files under src/, honest-test.toml,
  # the shipped step-library templates, and each collected test module's source — imports each module under
  # test, and runs injected code it did not write at the two engine boundaries (sections 11, 3.6, 4.8, 4.10,
  # 8.6). It writes four sinks: the human report to stdout, coverage.json and the scaffolding files to the
  # filesystem, and each proof event through an injected honest-observe runtime (sections 11, 9.5, 8.5).
  inputs  = { "file"        : "the source files under src/ read on a run, honest-test.toml read at run start, the shipped step-library template files read when scaffolding is produced, and each collected test module's source read at the pytest collection hook (sections 11, 3.6, 4.8, 8.4)",
              "process"     : "the running interpreter, its import system, and its subprocesses, the OS side honest-test touches three ways: the loader imports each module under test, executing its top-level code to obtain its live declarations (section 11); the memory-capped mutation harness runs each mutant's conformance suite in a bounded subprocess (section 9.6); and the value oracle runs code honest-test did not write — the function named by a suite case (section 8.6) — which is an unbounded process-level effect because the injected code may do anything; the published runtime checks likewise invoke caller-supplied programs, monitor hooks, component loaders, or a real database connection",
              "honest-parse" : "the grammar-directed parse_root_node door reads Python source for test-body checking, predicate analysis and mutation generation" }
  outputs = { "stdout"         : "the human-readable run report print_report writes on a CLI run (section 11)",
              "file"           : "coverage.json, which write_coverage writes on a run for honest-check to read (section 9.5), and the do-not-edit scaffolding files write_scaffolding writes into the configured scaffolding directory (sections 8.2, 10)",
              "honest-observe" : "the honest-observe module emit_proof_event writes each hf.proof.checked event to, through the runtime a conformance runner injects (section 8.5); the honest-observe.emit seam names the one-way coupling, present only when a runtime is wired in, so a pure local run emits nothing" }

  # ============================================================================================
  # Foreign shapes. honest-test reads declarations other modules own; it never constructs them.
  # ============================================================================================
  type Vocabulary = foreign "honest-type" note "a validated vocabulary, the value honest-type's vocabulary() produces: its base recognizers and composed types (honest-type-architecture.md). honest-test reads it to enumerate every Set member and every combination (section 3.2) and to drive chain-contract test cases (section 4.6). It is foreign because honest-type owns the shape; honest-test receives a Vocabulary and reads it, never builds one."
  type Binding = foreign "honest-type" note "a binding table mapping type names to slot names, honest-type's binding() result. honest-test reads it to know which slot each classified token fills when it builds a test manifest (section 4.6). Foreign: honest-type owns it."
  type Manifest = foreign "honest-type" note "a fully resolved classification result — slot names to values — honest-type's classify() output and the value every link and chain is run on. honest-test constructs test manifests by enumerating a vocabulary and hands them to the link under test (sections 4.1 through 4.6). Foreign: honest-type owns the shape; honest-test fills slots it already knows from the vocabulary, never redefines the record."
  type Result = foreign "honest-type" note "honest-type's Result: an ok arm carrying a manifest or an err arm carrying a fault, the value a chain run and a value-oracle case evaluation produce. honest-test reads which arm is present to judge a chain contract (section 4.6) and to compare a function's output against the oracle's expected value (section 8.6). Foreign: honest-type owns it."
  type Link = foreign "honest-type" note "the metadata a declared @link carries — its name, the vocabulary it accepts, its binding, whether it is a boundary, what it emits — honest-type's link_meta() shape. honest-test reads it to generate step scaffolding from a chain's links (section 8.2). Foreign: honest-type owns it. The runnable link itself is passed separately as a Callable plug."
  type StateMachine = foreign "honest-type" note "an immutable state machine — its states and events vocabularies, its transition table, its initial and terminal states — honest-type's state_machine() result. honest-test enumerates it to test every valid transition, every invalid pair, and adversarial state and event tokens (section 5). Foreign: honest-type owns it."
  type Schema = foreign "honest-persist" note "a declared persistence schema — its tables, columns, nullability and CHECK constraints — honest-persist owns the shape (honest-persist-architecture.md section 8). honest-test reads it to generate round-trip, required-field, empty-set and CHECK-constraint contract tests against a real in-memory database (section 6). Foreign: honest-persist owns it; honest-test drives the genuine query builders and execute against it through an injected connect."
  type AuthProvider = foreign "honest-auth" note "a registered authentication provider — its resolve_actor boundary validator, its actor_recognizer, its test_token_generator and its fault_mapping — honest-auth owns the shape (honest-auth-architecture.md sections 2.3 through 2.4). honest-test probes it with each token class and asserts the outcome (section 4.7). Foreign: honest-auth owns it; honest-test receives the provider as a parameter, never reaches a registry for it."
  type Node = foreign "tree-sitter" note "one parsed syntax-tree node, the value tree-sitter produces over a source string. honest-test parses each source file once with tree-sitter (sections 2, 9.6), then reads the tree: it finds each predicate node to classify its generation strategy (section 2) and reads length and numeric bounds off the comparison operators the node holds (sections 3.3, 3.4), and it reads node spans to locate a mutant (section 9.6). It is foreign because tree-sitter owns the shape; honest-test receives a node and reads it, never constructs one — the same reason honest-check's Node is foreign to tree-sitter."

  # ============================================================================================
  # The closed word-sets. Each is a finite set the notes fold over, declared so the engine is named
  # and counted rather than left in prose.
  # ============================================================================================

  set finding_kinds = {
    "failure"   : "the code is wrong and the gate fails: a purity, mutation, idempotency, chain-contract, auth, state-machine or persist contract violation",
    "warning"   : "a smell reported without failing the gate: I/O or non-determinism detected in a link not declared a boundary, or a predicate with no supplied-value entry (sections 4.4, 4.5, 3.6)",
    "rejection" : "a test body or a gate is dishonest and collection is refused: a runtime rebind (section 4.8) or an unverified gate (section 4.9)"
  } note "the three grades a Finding carries. failure and rejection block; warning reports and does not block. A rejection is the one grade raised at collection time rather than returned from a run."
  vocabulary FindingKind = { finding_kinds } note "the closed grade of a Finding; which of the three a given check produces is fixed by the check and pinned by the conformance suite (section 12.2)."

  set finding_codes = {
    "non_deterministic"              : "a pure link returned different results on identical input (section 4.1, failure)",
    "manifest_mutated"               : "a pure link modified its input manifest (section 4.2, failure)",
    "not_idempotent"                 : "a chain produced different results on identical input run twice (section 4.3, failure)",
    "io_detected"                    : "a link not declared a boundary performed I/O (section 4.4, warning)",
    "nondeterminism_detected"        : "a link not declared a boundary called a non-deterministic source on the watch list (section 4.5, warning)",
    "missing_supplied_values"        : "an external-lookup predicate has no entry in honest-test.toml, so no cases could be generated for it (section 3.6, warning)",
    "chain_contract"                 : "a downstream link rejected a valid output of the upstream link with a server fault (section 4.6, failure)",
    "auth_honesty"                   : "the auth provider accepted a malformed token, rejected a valid one, or did not fault correctly for a token class (section 4.7, failure)",
    "test_body_dishonest"            : "a test body rebinds a call target at runtime — monkeypatch, mock.patch, setattr or attribute assignment on an imported symbol (section 4.8, rejection)",
    "gate_unverified"                : "a declared gate has no proof-of-failure test (section 4.9, rejection)",
    "gate_proof_unbound"             : "a gate's proof does not bind the specific failure it expects and can pass on an unrelated error (section 4.9, rejection)",
    "transition_incorrect"           : "a valid transition produced the wrong next state (section 5.1, failure)",
    "invalid_transition_accepted"    : "a state and event pair with no declared transition was accepted instead of faulting no_transition (section 5.2, failure)",
    "invalid_state"                  : "an adversarial neighbor of a state was accepted instead of faulting invalid_state (section 5.3, failure)",
    "invalid_event"                  : "an adversarial neighbor of an event was accepted instead of faulting invalid_event (section 5.3, failure)",
    "round_trip_mismatch"            : "a row read back from the real database did not equal the row written (section 6.1, failure)",
    "undeclared_column_accepted"     : "a query builder referencing an undeclared column was not rejected at build time (section 6.1, failure)",
    "missing_required_field_accepted": "an insert omitting a non-nullable column was not rejected by the real database (section 6.1, failure)",
    "empty_set_faulted"              : "a select matching no rows returned a fault instead of ok of an empty list (section 6.1, failure)",
    "css_namespace_collision"        : "two components share a CSS class name instead of each namespacing under its own BEM block (section 7.1, failure)",
    "route_collision"                : "two components define the same route path (section 7.2, failure)",
    "startup_cascade"                : "one component failing to load caused another to fail, so the components are not independently loadable (section 7.3, failure)",
    "status_mismatch"                : "the response status did not equal the asserted code (section 8.4, failure)",
    "status_class_mismatch"          : "the response status did not fall in the asserted class, 2xx, 3xx, 4xx or 5xx (section 8.4, failure)",
    "content_type_mismatch"          : "the response Content-Type did not equal the asserted media type (section 8.4, failure)",
    "charset_mismatch"               : "the response character set did not equal the asserted one (section 8.4, failure)",
    "header_mismatch"                : "a named response header was absent or did not equal the asserted value (section 8.4, failure)",
    "header_present"                 : "a header asserted to be absent was present on the response (section 8.4, failure)",
    "body_bytes_mismatch"            : "the response body bytes did not equal the asserted bytes (section 8.4, failure)",
    "body_schema_violation"          : "the response body was not JSON conforming to the asserted schema (section 8.4, failure)",
    "body_selector_absent"           : "the response body was not HTML containing an element the asserted selector matches (section 8.4, failure)",
    "cookie_value_mismatch"          : "the response did not set a named cookie to the asserted value (section 8.4, failure)",
    "cookie_attribute_absent"        : "a named response cookie did not carry the asserted attribute (section 8.4, failure)",
    "cookie_max_age_mismatch"        : "a named response cookie's Max-Age did not equal the asserted seconds (section 8.4, failure)",
    "location_mismatch"              : "the response Location did not equal the asserted URL (section 8.4, failure)",
    "session_cookie_mismatch"        : "two responses in a sequence did not share one session cookie value (section 8.4, failure)"
  } note "the closed catalogue of codes honest-test's checks emit, one per failure or warning condition the spec names across sections 3.6 and 4 through 8. A Finding's code is exactly one of these. The set is declared so the verification engine is counted and a scenario can name the code it expects, rather than the codes living only in prose inside each check's note."
  vocabulary FindingCode = { finding_codes } note "the closed code space of a Finding; the exact code a given check produces for a given input is pinned by the conformance suite (section 12.2)."


  set supplied_strategies = {
    "supplied_only" : "the predicate cannot be analyzed, so honest-test runs only the valid and invalid values the programmer supplied in honest-test.toml (section 3.6)",
    "fibonacci"     : "the predicate is numeric and the programmer configured its Fibonacci generation — the limit, whether to include the negative direction, whether to divide by 100 for floats (sections 3.3, 10)"
  } note "the two generation strategies a honest-test.toml predicate entry may name (section 10). Declared so a supplied entry's strategy is a bounded word, not a free string."
  vocabulary SuppliedStrategy = { supplied_strategies } note "the closed strategy of one supplied predicate entry (section 10)."

  set token_classes = {
    "valid"     : "a well-formed, unexpired, unrevoked token; the provider must resolve it to ok(actor)",
    "revoked"   : "a revoked token; the provider must fault, categorized unauthenticated, mapped to 401",
    "expired"   : "an expired token; the provider must fault, categorized unauthenticated, mapped to 401",
    "malformed" : "a structurally invalid token; the provider's actor_recognizer must reject it before it reaches resolve_actor (400, or 401 if the provider prefers)",
    "missing"   : "no token supplied; the provider must fault, categorized unauthenticated, mapped to 401",
    "forged"    : "a token with a bad signature; the provider must fault, categorized unauthenticated, mapped to 401"
  } note "the six token classes the authentication-honesty test probes (section 4.7). This is the smallest set that exercises the boundary validator; the provider may override the class-to-outcome mapping. Declared so the auth probe's input space is named and counted."
  vocabulary TokenClass = { token_classes } note "the closed set of token classes the auth-honesty probe generates (section 4.7); compute_expected_status maps one to its expected HTTP status."

  set mutation_kinds = {
    "comparison_swap"   : "a comparison operator is swapped: < to <=, > to >=, == to != (section 9.6)",
    "number_shift"      : "a number is shifted by one: n to n+1 or n to n-1",
    "condition_flip"    : "a boolean condition is flipped: and to or, a removed not, x to not x",
    "constant_replace"  : "a constant is replaced: 0 to 1, a non-empty literal to empty, True to False",
    "result_swap"       : "a result is swapped: ok(...) to err(...) or the reverse",
    "line_removal"      : "one statement or one branch arm is deleted",
    "membership_change" : "a membership or key is changed: in and not in swap in either direction, a dict key to a sibling key"
  } note "the seven mechanical source changes honest-test applies for mutation adequacy, the fixed finite list of section 9.6, applied to every place each fits. Declared so the mutation engine is named and counted rather than hidden in the section 9.6 table alone."
  vocabulary MutationKind = { mutation_kinds } note "the closed kind of a Mutant, naming which row of the section 9.6 table applied; mutate_source tags every change it makes with one."

  set mutant_verdicts = {
    "caught"    : "at least one conformance case failed on the changed source, so the suite would detect the line being wrong (section 9.6)",
    "set_aside" : "the change left the suite's observed output identical, demonstrated not asserted, so the change cannot alter the result (section 9.6)",
    "undecided" : "the run hit its time or memory bound and produced no verdict, so nothing may be claimed about the change; it fails the gate exactly as an unexamined change does (section 9.6)"
  } note "the three verdicts a mutant run reaches (section 9.6). Adequacy requires caught plus set_aside to equal the total and no change left undecided. Declared so the adequacy judgement is enumerable and a scenario can assert the verdict for a given mutant run."
  vocabulary MutantVerdict = { mutant_verdicts } note "the closed verdict a MutantResult carries (section 9.6)."

  set proof_outcomes = {
    "proved" : "the function passed the honesty checks, is fully covered — 100% line and branch — and its gherkin Then steps passed (section 8.5)",
    "failed" : "at least one of honesty, coverage or the value oracle did not hold (section 8.5)"
  } note "the two outcomes a proof event carries (section 8.5). A function earns proved only when all three legs hold together; a value-oracle-exempt function waives the value leg only, never honesty or coverage. Declared so the proof-event outcome is a named two-member set."
  vocabulary ProofOutcome = { proof_outcomes } note "the closed outcome of one hf.proof.checked event (section 8.5)."

  # ============================================================================================
  # The data dictionary. honest-test's own records.
  # ============================================================================================

  type Fault = {
    problem: str
    remedy: str
  } note "honest-test's own failure record, raised by nothing in the interior and returned as a value: mutate_source returns it when the module source does not parse, run_suite passes it outward, and evaluate_case returns it when an expression names a function the map does not hold. problem states what went wrong in a sentence a developer reads — the source handed to the mutation engine is not parseable, or a value-oracle case referenced an unknown function name. remedy states what to do instead — fix the source so tree-sitter can parse it, or add the named function to the suite's function map. The two fields together make the fault self-explaining. A Fault travels by return out to the boundary: mutate_source to run_suite to the CLI door, and evaluate_case to its importing conformance runner."

  type ChainContract = {
    links: list<Callable>
    vocab: Vocabulary
    binding: Binding
  } note "the ready inputs for the chain-contract check of one discovered chain — its ordered links read from chain_meta, and the upstream link's accepted vocabulary and binding read from link_meta of the first link — so run_suite runs test_chain_contracts over it without any honest-type reflection of its own. links is the chain's links in order, the pairs test_chain_contracts checks each join between; vocab is the vocabulary the first link accepts and binding its binding, the pair that drives the case enumeration for the upstream link. Vocabulary and Binding are honest-type's foreign shapes already declared here; this record only groups them per chain as load_under_test read them at the boundary, so the check reaches no honest-type reflection itself."

  type LiveModules = {
    vocabularies: list<Vocabulary>
    bindings: list<Binding>
    links: list<Callable>
    link_declarations: list<Link>
    chains: list<Callable>
    chain_declarations: list<ChainContract>
    machines: list<StateMachine>
    schemas: list<Schema>
    components: list<Component>
    providers: list<AuthProvider>
    gates: list<Gate>
  } note "the live declarations and callables load_under_test obtains by dynamically importing the modules under test (section 11), the input the checks that must call real functions take. vocabularies are the live Vocabulary objects enumerate_sets and the chain-contract check permute; bindings are the live Binding tables that pair with them. links are the runnable link callables the honesty checks (purity, mutation, idempotency, boundary isolation, non-determinism) and the chain-contract check run — Callable because a link is run, not read, the honest-type idiom for an injected runnable. link_declarations are the same links read as metadata — their names, accepted vocabularies, bindings and emitted shapes, honest-type's link_meta the loader read off each — which generate_scaffolding reads to build a chain's step module (section 8.2); the runnable and the readable sit side by side because scaffolding reads the declaration while the honesty checks run the function. chains are the runnable chain callables. chain_declarations are the per-chain contract inputs load_under_test reads with honest-type's is_chain and chain_meta — to find each chain and its ordered links — and link_meta — to read the upstream link's accepted vocabulary and binding — each a ChainContract run_suite hands straight to test_chain_contracts (section 4.6); the runnable chains and the readable chain_declarations sit side by side the way links and link_declarations do, so run_suite runs the chain-contract check over the declarations without any honest-type reflection of its own. machines are the live StateMachine objects the three state-machine tests exercise. schemas are the live persistence schemas the persist contract and CHECK enumeration drive against a real database. components are the live Component records the three isolation checks compare. providers are the registered AuthProvider objects the auth-honesty probe exercises. gates are the self-declared Gate records the gate-honesty check verifies. Loading ran each module's own code, so this record is the fruit of a boundary, not of pure analysis; the pure checks take these values and run no import themselves."

  type Finding = {
    kind: FindingKind
    code: FindingCode
    message: str
    location: str
  } note "one result a honest-test check produces, carried as data, never thrown. kind is the grade — failure, warning or rejection — deciding whether it blocks. code is the exact condition from the closed FindingCode catalogue, naming which check fired and why. message is the human sentence naming what is wrong and, where the spec gives one, how to fix it — for example that a link produced different results on identical input, or that a test rebinds a call target at runtime and should pass the dependency as a parameter instead. location is where the finding sits as file:line:col for a rejection read off a source position (sections 4.8, 4.9), and the empty string for a run-time check whose finding has no single source line to point at. A check returns a list of these; an empty list means that check found nothing."

  type SuppliedEntry = {
    valid: list<str>
    invalid: list<str>
    strategy: SuppliedStrategy
  } note "one predicate's entry in honest-test.toml (sections 3.6, 10), the programmer-supplied test values for a predicate honest-test cannot analyze. valid is the list of values that must be accepted; invalid is the list that must be rejected; strategy is supplied_only or fibonacci, naming how the predicate is generated. read_config resolves one of these per predicate name."

  type SuppliedConfig = dict<str, SuppliedEntry> note "the resolved supplied-values record read_config hands the generators (section 3.6), keyed by predicate name. Each value is one SuppliedEntry. A predicate with no key here has no supplied values, which supplied_cases reports as the missing_supplied_values warning rather than a file lookup. The generators take this record as data and read no file."


  type Mutant = {
    location: str
    change_kind: MutationKind
    original: str
    replacement: str
  } note "one mechanical change to the module's own source (section 9.6). location is the tree-sitter node's span the change sits at. change_kind names which row of the section 9.6 table applied. original is the exact source text being replaced; replacement is what it becomes — a swapped operator, a shifted number, a flipped condition, an emptied literal, a deleted statement rendered as the empty string, or a changed membership or key. mutate_source produces one Mutant per place a kind fits, the way the generators enumerate a Set."

  type MutantResult = {
    verdict: MutantVerdict
    reason: str
  } note "the judgement of running one mutant against the suite (section 9.6). verdict is caught, set_aside or undecided. reason is empty for caught; for set_aside it is the demonstration that the change left the suite's observed output identical — named by its recurring kind, a guard on a value the parser always supplies, a trailing return that falls through to the same value, a constant shifted preserving order, an unreachable fallback, two commuting operations reordered; and for undecided it is the bound the run hit, time or memory. Every set_aside and undecided judgement stands on the record by name, never inferred from a clock."

  type MutantObservation = {
    output: str
    completed: bool
  } note "what the memory-capped mutation harness observed from running one source through the conformance suite out of process (section 9.6), the value run_mutant_suite returns and classify_mutant_result judges. output is the suite's observed output on that source as text — the pass/fail report run_mutant_suite captured from the bounded subprocess. completed is true when the run finished inside its time and memory bound and false when it hit either, the case that becomes the undecided verdict because a run that produced no verdict may claim nothing about the change. run_suite observes the unchanged source once for the baseline and each mutant once, and hands the pair to classify_mutant_result."

  type Coverage = {
    total: int
    exercised: int
    pct: int
  } note "one coverage dimension's numbers (section 9). total is how many things could be exercised — Set members, input-reachable fault exits, links, or declared transitions, depending on the dimension. exercised is how many were. pct is exercised over total as a whole-number percentage. Set enumeration and exhaustive transition testing drive their dimensions to 100 by construction; chain coverage counts only the fault exits an input can reach, and names the state-dependent ones it cannot rather than reporting them covered (section 9.2.2)."

  type CoverageReport = {
    version: str
    vocabularies: dict<str, Coverage>
    chains: dict<str, Coverage>
    honesty: dict<str, Coverage>
    state_machines: dict<str, Coverage>
  } note "the whole coverage result build_coverage_report assembles, which write_coverage writes as coverage.json (section 9.5) and honest-check reads for HC-P009 and other cross-tool checks. version is the format version, '1.0'. vocabularies maps each vocabulary name to its member coverage; chains maps each chain name to its fault-exit coverage; honesty maps each chain name to the share of its links that passed every honesty check; state_machines maps each machine name to its transition coverage. Each value is one Coverage record."

  type RunReport = {
    chains: int
    links: int
    vocabularies: int
    permutations: int
    failures: int
    adversarial_rejected: int
    warnings: int
    coverage: CoverageReport
    mutation_caught: int
    mutation_total: int
  } note "the assembled result of one CLI run, which print_report renders to the human report on stdout and whose coverage field write_coverage writes to coverage.json (section 11). chains, links and vocabularies are how many of each the run found under src/. permutations is how many generated cases ran; failures is how many failed. adversarial_rejected is how many near-miss inputs were correctly rejected. warnings is how many honesty warnings the monitored checks raised (a non-boundary link that performed I/O), which report and do not block. coverage is the four-dimension CoverageReport. mutation_caught and mutation_total are the mutation-adequacy tally (section 9.6): adequacy holds when every change was caught or demonstrably set aside with none left undecided."


  type ComponentRoute = {
    path: str
  } note "one route a component defines, the minimal shape honest-test reads for route-isolation (section 7.2). path is the route's URL path, checked for collision across components. The full route record lives in honest-page; honest-test reads only the path."

  type ComponentStartup = {
    name: str
    loaded: bool
  } note "one observed forward component load, in input order, used to report the earlier failure that preceded a cascade."

  type Component = {
    name: str
    template: str
    routes: list<ComponentRoute>
  } note "the minimal read-subset of a component definition honest-test touches for isolation checks (section 7). name identifies the component in a collision message. template is the HTML honest-DOM renders, from which extract_css_classes pulls the CSS class names that must not collide with another component's (section 7.1). routes is the component's routes, each carrying a path, checked for collision across components (section 7.2). The full component record lives in honest-page; honest-test reads only these three fields."

  type Gate = {
    name: str
    location: str
    proof: Proof | NOTHING
  } note "one declared gate — any check whose purpose is to stop the run: a fixture precondition, a session guard, a marker selection, a required-resource assertion, a lint rule, a build step (section 4.9). A gate declares itself; honest-test never guesses which checks are gates. name identifies it in a rejection message; location is where it sits. proof is the proof-of-failure test paired with it, or NOTHING when none is paired — the absence case check_gate_honesty rejects as gate_unverified. The absence is an explicit bounded value, so the check never has to tell a missing proof from a forgotten one."

  type Proof = {
    location: str
    binds_failure: bool
  } note "a gate's proof-of-failure test (section 4.9): a test that supplies the gate a known-bad input and requires the specific failure. location is where the proof sits. binds_failure is true when the proof requires the specific failure type and message, and false when it asserts only that some exception was raised — the one-level-up defect check_gate_honesty rejects as gate_proof_unbound, because a proof that catches only the ordinary exception type cannot see a failure raised from the root type, so its own observing arm is unreachable."

  type SuiteCase = {
    function: str
    input: any
    args: list<any>
    kwargs: dict<str, any>
    expected: any
  } note "one portable value-oracle case from suite.json (section 8.6, section 12.2), the single source of the known-good (arguments, expected) pairs so the values are never authored twice. function is the name of the function under test, resolved from the function map. The call's arguments are given one of three ways: a single input, a positional args list, or a keyword kwargs map; a case uses whichever fits. expected is the known-good value the output is compared against. Each argument and the expected value is a portable value: a literal (itself), a reference written as the one-key map {\"$ref\": name} that resolves to a callable from the function map so a function that takes another function is reachable by naming it, or a call written as {\"$call\": name, \"args\": [...]} that applies a named function to its resolved arguments. The case carries no callable in the data, only names resolved from the map, which keeps suite.json pure, language-agnostic data so a second-language implementation proves conformance by running the same file."

  type ResolvedCall = {
    function: Callable
    args: list<any>
    kwargs: dict<str, any>
    expected: any
  } note "a suite case resolved against the function map and ready to run (section 8.6), what resolve_call produces from a SuiteCase and run_resolved_call runs. function is the concrete callable the case's function name resolved to. args is the positional arguments and kwargs the keyword arguments, each a resolved portable value: a literal is itself, a $ref has been looked up to its callable in the map, and a $call is a deferred application run_resolved_call applies at the boundary; resolution here only reads the map and never runs code, so resolve_call stays pure and every execution waits for the boundary. expected is the resolved known-good value compare_output judges the output against. A case that named a function or expression the map does not hold never becomes a ResolvedCall — resolve_call returns a Fault instead — so a ResolvedCall is always runnable."

  type ProofEvent = {
    function_name: str
    scenario: str
    cases_run: int
    outcome: ProofOutcome
    line_coverage: int
    branch_coverage: int
  } note "one hf.proof.checked event honest-test builds per function it proves (section 8.5), for the host runner to emit through an injected honest-observe runtime — honest-test's core takes no dependency on honest-observe, so a pure local run with no runtime wired emits nothing. function_name is the fully-qualified name, which is the function's one gherkin requirement and its function-point unit, so the events are a gap-free requirement-to-proof-to-result record. scenario is the gherkin scenario name. cases_run is how many cases the function was run on. outcome is proved or failed. line_coverage and branch_coverage are the function's coverage percentages. honest-test builds this record and returns it; the emit is the runner's boundary."

  # ============================================================================================
  # The doors. The CLI run start and the pytest collection hook are host-started, so each arrives on a
  # call-form entry the entry-check reports UNCHECKED. The value-oracle engine, evaluate_case, is
  # declared further down with its orchestrator; a sibling module enters it by import.
  # ============================================================================================
  boundary_in fn run_cli : (src_dir: str) -> RunReport | Fault invokes run_suite note "the CLI door the host starts with `python -m honest_test [src_dir]` (section 11). src_dir is the source directory to scan, as typed on the command line and already in memory; run_cli opens no file itself — the orchestrator's readers do the filesystem reads. It hands src_dir to run_suite, which drives the whole run, and returns what run_suite returned: the assembled RunReport on a completed run, or the Fault run_suite passed outward when the module source could not be parsed for mutation (section 9.6). The two sinks that print the report and write coverage.json are driven inside run_suite, so a completed run has already reported by the time run_cli returns. It raises nothing: a run that could not complete comes back as a Fault for the host to discharge as a non-zero exit."
  boundary_in fn check_test_body : (collector: handle) -> list<Finding> raises "collection_failure" invokes run_body_check side_effect reads "file" note "the pytest plugin's collection-time hook (section 4.8). pytest hands it the collector for one test module; honest-test reads that module's source through the collector — the injected collector carries a path whose read_text returns the source, so the read is substituted by passing a stand-in collector rather than by patching — and hands the source to run_body_check for the pure verdict. collector is the opaque pytest collection object; honest-test reads only the module source from it and touches nothing else. It returns the list of rejections the verdict produced, and raises collection_failure when that list is non-empty, naming each rebinding site, so a test body that rebinds a call target at runtime does not run. A returned empty list means the module collected clean. Its one side effect is reading the collected module's source file."

  # ============================================================================================
  # The readers. The source reader pulls each file under src/; the config reader pulls honest-test.toml
  # once at run start and resolves the programmer-supplied values (sections 11, 3.6).
  # ============================================================================================
  reader fn read_source : (path: str) -> str side_effect reads "file" note "the source reader (section 11). It pulls one file's complete text from disk and hands it back as a string, so the orchestrator can parse it and generate from it. path is the filesystem path of one source file under src/, already resolved by discovery at the run boundary. It returns that file's full contents as a string and does nothing else: it does not parse, generate or write. Its one side effect is reading the filesystem."
  reader fn load_under_test : (src_dir: str) -> LiveModules side_effect reads "file" side_effect reads "process" pure_call "honest-type.link_meta" note "the loader reader (section 11), the one way honest-test's boundary is wider than honest-check's: it does not merely read source text, it imports each module under test to obtain the module's live vocabularies, links, chains, state machines, schemas, components, providers and gates. src_dir is the source directory whose modules it loads. It returns a LiveModules record carrying those live values for the orchestrator to thread into the checks that must call real functions — vocabulary permutations, the honesty checks, chain contracts, state machines, persist contracts and component isolation. It also discovers each module's chains with honest-type's is_chain, reads each chain's ordered links with chain_meta and the upstream link's accepted vocabulary and binding with link_meta, and returns them as chain_declarations — one ChainContract per chain — beside the runnable chains, so run_suite drives the chain-contract check over the declarations and never reflects on honest-type itself. Loading runs each module's own top-level code, so it is a boundary, not pure analysis: it reads the module files from disk, executes them into the running interpreter, and asks honest-type to tell a link from an ordinary function and a chain from an ordinary callable and read their declared vocabulary, binding and ordered links off them — honest-type's link_meta, is_link, is_chain, chain_meta and vocabulary machinery, the one seam by which honest-test depends on honest-type. Its side effects are reading the filesystem, reading the import system of the running process, and the honest-type seam that interprets what it loaded. honest-check reaches no such breadth because its rules are decidable from source text; honest-test's live checks are not, which is why this second reader exists." note "The current src_dir supplies each selected module’s source identity for this invocation (§11). A process-cached module from a different directory with the same stem supplies none of its live declarations. During import, ordinary sibling imports of selected files resolve within this source directory and reuse the same live module per file for this invocation. Any import search path or name binding temporarily installed by this reader is restored on success and on import failure. Unrelated cached modules retain their original bindings. The return remains the LiveModules record of the actual loaded objects."
  reader fn read_config : (path: str) -> dict<str, any> side_effect reads "file" note "the config reader (sections 3.6, 10). It reads honest-test.toml once at the start of a run and decodes it to the plain parsed table — nothing more. path is the path to honest-test.toml. It returns the decoded TOML as a plain map of maps, the standard-format decode HC-R006's second carve-out allows a door to do; it builds no record and resolves nothing, so it never reshapes the world's data into the module's own shape. The resolution into the SuppliedConfig record is resolve_supplied_config, a pure function the orchestrator calls after this pull. The table is empty when no honest-test.toml exists. Its one side effect is reading the filesystem."
  fn resolve_supplied_config : (table: dict<str, any>) -> SuppliedConfig note "resolves the decoded honest-test.toml table into the supplied-values record the generators take (sections 3.6, 10), the transformation HC-R006 moves out of the config reader into the pure core. table is the plain parsed TOML read_config returned. It returns a SuppliedConfig: a map from each predicate name to its SuppliedEntry — the predicate's valid list, its invalid list, and its strategy (supplied_only or fibonacci). It is the empty map when the table declares no predicates. It reads no world and returns pure data; the supplied values entered at the boundary in read_config, and this function only reshapes them."

  reader fn read_template : (path: str) -> str side_effect reads "file" note "the template reader (sections 8.2, 8.4, 8.6). It reads one shipped step-library template file's complete text from honest-test's package and hands it back as a string, so run_suite can write it into the adopter's scaffolding directory alongside the generated chain scaffolding. path is the filesystem path of one shipped template file — the §8.4 protocol-assertion step library and the §8.6 value-assertion step library are each such a file, template material honest-test ships the same for every app, not functions honest-test's own run reaches. It returns that file's full contents as a string and does nothing else: it does not generate, resolve or write. Its one side effect is reading the filesystem."
  reader fn run_mutant_suite : (source: str) -> MutantObservation side_effect reads "process" note "the memory-capped mutation harness (section 9.6), the boundary that runs one source through the conformance suite out of process. source is the module source to run — the unchanged source for the baseline observation, or one mutant's changed source produced by mutate_source. It launches a subprocess bounded in time and in memory, runs the module's conformance suite against that source, and returns a MutantObservation: the suite's observed output as text and whether the run finished inside the bound. The mutant runs out of process, never inline, because an infinite-loop mutant must not run in honest-test's own process — a prior inline run reached 35 GB before it was killed. Its one side effect is reaching into the running process's subprocesses; the judging of what it observed is classify_mutant_result's pure work, not the harness's."
  reader fn io_monitor : (link: Callable, test_manifest: Manifest) -> list<str> side_effect reads "process" note "the boundary-isolation monitor (section 4.4), the kind=io plug run_suite injects into verify_under_monitor. It is record-and-restore instrumentation: it temporarily patches the known I/O functions — open, print, input, and sys.stdout, sys.stderr and sys.stdin — so that each one records the call it was given and then delegates to the real function, restoring the original afterward and changing no result, so it is not the runtime rebinding section 4.8 forbids. link is the link under test, run once inside the instrumentation; test_manifest is the one generated input the link is run on. It returns the record of detected I/O calls as the list of call names, empty when the link did no I/O — the record verify_under_monitor judges against the link's boundary flag to decide the io_detected warning. It runs the injected link and touches the interpreter's I/O surface, a process-level effect of the same breadth as load_under_test and run_mutant_suite, which is why it is a reader over the running process rather than a pure function. Its one side effect is reaching into the running process to patch, run and restore."
  reader fn call_monitor : (link: Callable, test_manifest: Manifest) -> list<str> side_effect reads "process" note "the non-determinism monitor (section 4.5), the kind=nondeterminism plug run_suite injects into verify_under_monitor, the parallel reader to io_monitor. It is record-and-restore instrumentation: it temporarily patches the non-deterministic watch-list call-forms — time.time, time.monotonic, time.perf_counter, time.time_ns, random.random, random.randint, uuid.uuid4 and os.urandom — so that each one records the call it was given and then delegates to the real function, restoring the original afterward and changing no result, so it is not the runtime rebinding section 4.8 forbids. link is the link under test, run once inside the instrumentation; test_manifest is the one generated input the link is run on. It returns the record of detected non-deterministic call names, empty when the link called none — the record verify_under_monitor judges against the link's boundary flag to decide the nondeterminism_detected warning. By patching the target symbols it catches non-determinism that enters through an attribute chain or dynamic dispatch, the dynamic paths static HC008 misses. honest-test carries the call-form subset it traps rather than importing honest-check's NONDETERMINISTIC_WATCH_LIST module, and its conformance verifies the subset against the published list so the two cannot drift. It runs the injected link and touches the interpreter's symbols, a process-level effect of the same breadth as load_under_test and io_monitor, which is why it is a reader over the running process rather than a pure function. Its one side effect is reaching into the running process to patch, run and restore."

  # ============================================================================================
  # The orchestrators. run_suite drives the CLI run; run_body_check drives the collection verdict.
  # ============================================================================================
  orchestrator fn run_suite : (src_dir: str) -> RunReport | Fault invokes chain_contract_findings, server_rejection, enumerate_test_cases, monitor_findings, read_monitored_link, mutation_findings, purity_findings, invoke_probe, read_source, read_config, resolve_supplied_config, load_under_test, read_template, parse_source, source_mutants, extract_predicates, io_monitor, call_monitor, run_mutant_suite, classify_mutant_result, generate_scaffolding, write_scaffolding, build_proof_event, emit_proof_event, build_run_report, render_report, print_report, write_coverage pure_call "honest-type.is_fault" pure_call "honest-test-pure.classify_predicate" pure_call "honest-test-pure.enumerate_lengths" pure_call "honest-test-pure.fibonacci_sequence" pure_call "honest-test-pure.supplied_cases" pure_call "honest-test-pure.enumerate_sets" pure_call "honest-test-pure.check_gate_honesty" pure_call "honest-test-pure.test_valid_transitions" pure_call "honest-test-pure.test_invalid_transitions" pure_call "honest-test-pure.test_adversarial_state_machine" pure_call "honest-test-pure.enumerate_check_constraints" pure_call "honest-test-pure.test_css_isolation" pure_call "honest-test-pure.test_route_isolation" pure_call "honest-test-pure.coverage_ratio" pure_call "honest-test-pure.build_coverage_report" note "the orchestrator the CLI door hands its source directory to (section 11). It pulls the decoded config table once with read_config and resolves it to the supplied-values record with resolve_supplied_config, and it loads the modules under test once with load_under_test to obtain their live vocabularies, links, link declarations, chains, chain declarations, state machines, schemas, components, providers and gates. Over both readers' results it drives the whole pure core. From the source text: for each file it pulls the text with read_source, parses it once with parse_source, source_mutants, and runs the source-decidable checks — extract_predicates finds each predicate node, classify_predicate sorts it, and the matching generator runs (enumerate_lengths for a length-bounded predicate, fibonacci_sequence for a numeric one with the limit and direction the config carries, supplied_cases for an external-lookup predicate), then mutate_source produces the mutants for the adequacy measure. From the live values: enumerate_sets permutes each vocabulary, the honesty checks (verify_under_monitor) run each link, the chain-contract steps check each adjacent pair and use is_fault on the upstream answer to avoid passing a fault downstream, test_auth_honesty probes each provider, check_gate_honesty verifies each gate, the three state-machine tests exercise each machine, test_persist_schema_contract and enumerate_check_constraints drive each schema, and the three component-isolation checks compare the components. For mutation adequacy it runs the unchanged source once and each mutant once out of process with run_mutant_suite and judges each with classify_mutant_result (section 9.6). It generates the chain step scaffolding with generate_scaffolding from the loaded link declarations, reads the shipped standard step-library templates with read_template, and writes both to the scaffolding directory with write_scaffolding (sections 8.2, 8.4). For each function it proves it builds an hf.proof.checked event with build_proof_event and emits it through the injected observe runtime with emit_proof_event (section 8.5). It measures coverage with coverage_ratio and assembles it with build_coverage_report, assembles the whole RunReport with build_run_report, renders the report text with render_report and writes it to stdout with print_report, writes coverage.json with write_coverage, and returns the assembled RunReport. It returns the Fault mutate_source answers when the module source does not parse, passing it outward to the door rather than swallowing it. The value-oracle engine (evaluate_case) is not driven here: a sibling module's conformance runner enters it through its own door. src_dir is the directory to scan. One run resolves one config, loads once, and governs the whole scan."
  orchestrator fn run_body_check : (source: str) -> list<Finding> invokes parse_source, body_findings note "parse the supplied Python source through the shared reader, then return the test-body findings over the root. The pytest collector and the published source-text door both use this path."

  boundary_in fn test_body_violations : (source: str) -> list<Finding> invokes run_body_check note "the published test-body scan for supplied Python source (section 4.8). Pass the source unchanged to run_body_check and return its findings."
  fn body_findings : (root: Node) -> list<Finding> pure_call "honest-parse-tree.walk" pure_call "honest-parse-tree.line_col" note "the pure verdict of the test-body honesty rule (section 4.8), the one function the whole collection gate rests on. It walks the recovered root of the test module, which may contain parser errors, and returns one rejection Finding per statement that rebinds a call target at runtime: a monkeypatch fixture (setattr, setitem, delattr, setenv), a mock.patch or patch.object or a Mock installed as a call target, a setattr on an imported module, class or function, or an imported symbol rebound by attribute assignment. Each such statement exercises a call graph that is not production's, so the test proves a behaviour of the patched graph rather than the shipped code. The framework's own record-and-restore boundary instrumentation (io_monitor, call_monitor) is not a violation and never appears here: it lives in framework code, not a test body, and restores the original rather than leaving a behaviour-changing stand-in, so the rule fires only on a test body that installs a stand-in which alters behaviour. root is the shared parser’s root node for the complete module. It returns the rejections, each carrying the rebinding site's location and the fix — pass the dependency as a parameter, or inject a boundary plug as an argument; an empty list means the test body is honest. It reads nothing and raises nothing."

  # ============================================================================================
  # The sinks. Two boundary_out: the human report to stdout and coverage.json to the filesystem.
  # ============================================================================================
  boundary_out fn print_report : (text: str) -> NOTHING side_effect writes "stdout" note "the human-report sink (section 11). It writes the already-rendered report text to standard output and does nothing else — no formatting, no decision. text is the finished report string render_report produced; splitting the rendering out keeps this door declarative under HC-R006, which forbids a boundary from deriving a representation. It returns nothing; its one side effect is writing stdout."
  boundary_out fn write_coverage : (report: RunReport) -> NOTHING side_effect writes "file" note "the coverage.json sink (sections 11, 9.5). It writes the report's CoverageReport as coverage.json, the file honest-check reads for HC-P009 (a roled function without a gherkin) and other cross-tool checks. report is the finished RunReport; write_coverage writes its coverage field. It returns nothing; its one side effect is writing the file. It makes no decision — the coverage numbers are already measured."
  boundary_out fn write_scaffolding : (path: str, source: str) -> NOTHING side_effect writes "file" note "the scaffolding sink (sections 8.2, 10). It writes one do-not-edit scaffolding file into the configured scaffolding directory — the chain step module generate_scaffolding produced, or a shipped standard step-library template read_template read — and does nothing else. path is the file to write under scaffolding_dir; source is the finished scaffolding text. The developer writes .feature files against what these files expose and never edits them. It returns nothing; its one side effect is writing the file. It makes no decision — the source is already produced."
  boundary_out fn emit_proof_event : (event: ProofEvent, runtime: Callable) -> NOTHING side_effect writes "honest-observe.emit" note "the proof-event sink (section 8.5). It emits one hf.proof.checked event through honest-observe's emit and does nothing else. event is the ProofEvent build_proof_event produced; runtime is the observe emit a conformance runner wired into the run, injected as a Callable so honest-test's core takes no import dependency on honest-observe and the dependency runs one way, test to observe, at the run boundary only — the seam honest-observe.emit names that one-way coupling. A pure local run with no runtime wired emits nothing, so the write happens only when a runtime is present. It returns nothing; its one side effect is writing to honest-observe through the injected runtime. It makes no decision — the event is already built."

  # ============================================================================================
  # The pure core the orchestrator drives: parse, classify, and the source-reachable generators.
  # ============================================================================================
  reader fn parse_source : (source: str) -> Node side_effect reads "honest-parse.parse_root_node" note "encode the complete source to UTF-8 and ask the Honest Parse raw inspection door for its Python root. The known Python grammar returns a node for well-formed and malformed source alike; callers apply their own verdict to the root."
  fn extract_predicates : (tree: Node) -> list<Node> note "walks a parsed source tree and returns the node of each recognizer predicate it holds (section 2), so each can be classified and generated from. tree is the root node parse_source produced. It returns one node per predicate found, each the body honest-test analyzes; an empty list means the file declares no predicates. It reads no world and returns pure data."

  # ============================================================================================
  # The pure generators and checks run_suite drives over the live declarations. Each is a pure function
  # run_suite invokes and the conformance runner may also import to run with the live vocabularies and
  # callables the CLI cannot read from source text; the import entries below name that second caller.
  # ============================================================================================
  reader fn invoke_probe : (function: Callable, argument: any) -> any side_effect reads "process" note "invoke the supplied unary callback once with the supplied object and return its exact answer. Preserve object identity, propagate callback exceptions, and leave awaitables untouched. Checks supply their own copies when their specifications require isolation."

  reader fn read_monitored_link : (monitor: Callable, link: Callable, test_manifest: Manifest) -> list<str> side_effect reads "process" note "call the supplied monitor once with the exact link and manifest provided and return its watched-call record. The monitor owns instrumentation and restoration. Exceptions propagate."

  reader fn read_schema_probe : (table_name: str, table: any, connect: Callable) -> list<SchemaProbeOutcome> side_effect reads "process" note "open a fresh injected real database as section 6.1 requires, create this table, and run its four probes in order: round-trip, undeclared column, first non-primary non-nullable field when present, and no matching rows. Return the observed outcome of each attempted probe in that order. Initial connect and table creation failures propagate. Catch probe errors as outcomes and preserve valid empty result versus failed select."

  reader fn read_component_startup : (load_component: Callable, component: Component) -> ComponentStartup side_effect reads "process" note "call the supplied loader once for this exact component and return its name with whether it returned. An Exception raised by the loader is an observed load failure; BaseException propagates."

  fn purity_findings : (first: any, second: any) -> list<Finding> note "return an empty list when the results are equal, otherwise the existing single non_deterministic failure."

  fn mutation_findings : (before: Manifest, after: Manifest) -> list<Finding> note "return an empty list when before and after are equal, otherwise the single manifest_mutated failure containing their representations."

  fn idempotency_findings : (first: any, second: any) -> list<Finding> note "return an empty list when the results are equal, otherwise the existing single not_idempotent failure."

  fn monitor_findings : (link: Callable, record: list<str>, kind: str) -> list<Finding> pure_call "honest-type.link_meta" note "return no finding when the record is empty or the link metadata marks it a boundary; otherwise return the existing warning with the recorded calls. A nondeterminism check uses nondeterminism_detected and an io or unrecognized kind uses io_detected."

  fn server_rejection : (answer: any) -> bool pure_call "honest-type.is_fault" note "return true exactly when the downstream answer is a fault in the server category."

  fn chain_contract_findings : (rejected: bool) -> list<Finding> note "translate a downstream server rejection into the existing single chain_contract failure. Return an empty list when the join did not fail."

  fn auth_probe_mode : (token_class: TokenClass) -> str note "return valid for the valid class, malformed for the malformed class, and faulting for revoked, expired, missing, and forged, in that probe order."

  fn auth_probe_findings : (token_class: TokenClass, mode: str, accepted: bool, resolved: any, fault_mapping: dict<str, int>, expected: int) -> list<Finding> note "malformed is sound only when the recognizer rejected; valid is sound only when accepted and resolved ok; other classes are sound only when accepted and the resolved fault category maps to the expected status. A sound observation returns no findings; otherwise return the original auth_honesty failure for that class."

  fn startup_cascade_findings : (names: list<str>, reverse: dict<str, bool>, forward: list<ComponentStartup>) -> list<Finding> note "return a failure for each component that loaded in reverse order but failed in forward order. In forward order the trigger is the first earlier failed component, or the established earlier-component message when no failed component precedes it."

  boundary_in fn verify_purity : (link: Callable, test_manifest: Manifest) -> list<Finding> invokes run_purity_check note "the published verify_purity entry (section 4.1). It hands its supplied arguments unchanged to run_purity_check and returns that check’s findings."
  orchestrator fn run_purity_check : (link: Callable, test_manifest: Manifest) -> list<Finding> invokes invoke_probe, purity_findings note "Copy the original manifest separately before each call, invoke the identical link twice in order, then compare the two answers. The door preserves the original manifest."
  boundary_in fn detect_mutation : (link: Callable, test_manifest: Manifest) -> list<Finding> invokes run_mutation_check note "the published detect_mutation entry (section 4.2). It hands its supplied arguments unchanged to run_mutation_check and returns that check’s findings."
  orchestrator fn run_mutation_check : (link: Callable, test_manifest: Manifest) -> list<Finding> invokes invoke_probe, mutation_findings note "Take a deep copy of the original manifest, invoke the link once with the original object, and compare the original object after execution with the saved copy. The verdict includes the before and after representations."
  boundary_in fn test_idempotency : (chain: Callable, test_manifest: Manifest) -> list<Finding> invokes run_idempotency_check note "the published test_idempotency entry (section 4.3). It hands its supplied arguments unchanged to run_idempotency_check and returns that check’s findings."
  orchestrator fn run_idempotency_check : (chain: Callable, test_manifest: Manifest) -> list<Finding> invokes invoke_probe, idempotency_findings note "Run the chain twice in order, each time on a fresh deep copy of the original manifest, and compare the two answers."
  boundary_in fn verify_under_monitor : (link: Callable, test_manifest: Manifest, monitor: Callable, kind: str) -> list<Finding> invokes run_monitor_check note "the published verify_under_monitor entry (sections 4.4 and 4.5). It hands its supplied arguments unchanged to run_monitor_check and returns that check’s findings."
  orchestrator fn run_monitor_check : (link: Callable, test_manifest: Manifest, monitor: Callable, kind: str) -> list<Finding> invokes read_monitored_link, monitor_findings note "Ask the supplied monitor to run the supplied link with the original manifest once. Judge the resulting watched-call record using the check kind and the link metadata. The default verdict kind for an unrecognized kind remains io_detected."
  boundary_in fn test_chain_contracts : (links: list<Callable>, vocab: Vocabulary, binding: Binding) -> list<Finding> invokes run_chain_contract_check note "the published test_chain_contracts entry (section 4.6). It hands its supplied arguments unchanged to run_chain_contract_check and returns that check’s findings."
  orchestrator fn run_chain_contract_check : (links: list<Callable>, vocab: Vocabulary, binding: Binding) -> list<Finding> invokes enumerate_test_cases, invoke_probe, server_rejection, chain_contract_findings pure_call "honest-type.is_fault" note "For each adjacent pair in order enumerate the case manifests. Invoke the upstream link for each manifest. Only when the answer is not a fault invoke the downstream link on that answer. A downstream server fault alone is a failed join."
  fn enumerate_test_cases : (accepts: Vocabulary, binding: Binding) -> list<Manifest> note "builds the input manifests a link accepts, for chain-contract testing (section 4.6). accepts is the vocabulary the link declares it accepts; binding is the binding that names which slot each classified token fills. It enumerates the vocabulary the way enumerate_sets does and resolves each combination into a manifest through the binding, so each case is a ready input for the link under test. Each manifest is honest-type's manifest shape, a map from slot name to value, the binding naming the slot each member fills rather than the member's own type name; the same Maybe and predicate rules enumerate_sets follows hold here. It returns the list of manifests. It reads no world and returns pure data."
  boundary_in fn test_auth_honesty : (provider: AuthProvider) -> list<Finding> invokes run_auth_honesty_check note "the published test_auth_honesty entry (section 4.7). It hands its supplied arguments unchanged to run_auth_honesty_check and returns that check’s findings."
  orchestrator fn run_auth_honesty_check : (provider: AuthProvider) -> list<Finding> invokes invoke_probe, compute_expected_status, auth_probe_mode, auth_probe_findings note "Probe the six token classes in the declared mode order. Generate the token and run its recognizer once for every probe. Resolve only an accepted non-malformed token. Route the observations and expected status to the pure verdict. Unexpected callback errors escape the door."
  fn compute_expected_status : (token_class: TokenClass, fault_mapping: dict<str, int>) -> int note "maps one token class to the HTTP status the auth-honesty check expects (section 4.7). token_class is the class being probed; fault_mapping is the provider's optional override of the default class-to-outcome mapping. It returns the expected status: 401 for revoked, expired, missing and forged (an unauthenticated fault), 400 or the provider's preferred status for malformed (rejected at the recognizer), and the ok path for valid carries no error status. The provider may override the default through fault_mapping. It reads no world and returns pure data."
  set schema_probe_outcomes = {
    "round_trip_equal", "round_trip_mismatch",
    "undeclared_column_rejected", "undeclared_column_accepted",
    "missing_required_field_rejected", "missing_required_field_accepted",
    "empty_rows", "empty_set_faulted"
  } note "the terminal observations from the four schema probes after successful fixture setup (spec 6.1)."
  vocabulary SchemaProbeOutcome = { schema_probe_outcomes }

  fn schema_probe_findings : (table: str, outcome: SchemaProbeOutcome) -> list<Finding> note "pure interpretation of one completed schema probe for the declared table named by table. round_trip_equal, undeclared_column_rejected, missing_required_field_rejected and empty_rows each return an empty list. Each other observation returns one Finding of kind failure, code equal to the observation, message identifying the table and the broken contract, and empty location. round_trip_mismatch covers an unequal row or a fault during a valid round-trip probe. empty_set_faulted covers a fault or nonempty rows from a valid no-match probe. Fixture setup failures are outside this outcome vocabulary (spec 6.1)."

  boundary_in fn test_persist_schema_contract : (schema: Schema, connect: Callable) -> list<Finding> invokes run_persist_schema_check note "the published test_persist_schema_contract entry (section 6.1). It hands its supplied arguments unchanged to run_persist_schema_check and returns that check’s findings."
  orchestrator fn run_persist_schema_check : (schema: Schema, connect: Callable) -> list<Finding> invokes read_schema_probe, schema_probe_findings note "For each schema table in declaration order ask the reader to drive a fresh real injected connection. Translate each ordered probe outcome into findings with schema_probe_findings."
  boundary_in fn test_startup_isolation : (components: list<Component>, load_component: Callable) -> list<Finding> invokes run_startup_isolation_check note "the published test_startup_isolation entry (section 7.3). It hands its supplied arguments unchanged to run_startup_isolation_check and returns that check’s findings."
  orchestrator fn run_startup_isolation_check : (components: list<Component>, load_component: Callable) -> list<Finding> invokes read_component_startup, startup_cascade_findings note "Run the supplied loader in reverse input order once per component, then in input order once per component. Judge the difference between the named observations in the same order as the original components."
  fn build_run_report : (chains: int, links: int, vocabularies: int, permutations: int, failures: int, adversarial_rejected: int, warnings: int, coverage: CoverageReport, mutation_caught: int, mutation_total: int) -> RunReport note "assembles the finished RunReport from the measured pieces (section 11), so the report the sinks consume is produced by a pure function on run_suite's path rather than reshaped inside a door. chains, links and vocabularies are how many of each the run found; permutations is how many generated cases ran and failures how many failed; adversarial_rejected is how many near-miss inputs were correctly rejected; warnings is how many honesty warnings the monitored checks raised, a non-boundary link that performed I/O, which report and do not block; coverage is the CoverageReport build_coverage_report produced; mutation_caught and mutation_total are the adequacy tally. It returns the RunReport render_report renders and write_coverage writes. It reads no world and returns pure data."
  fn render_report : (report: RunReport) -> str note "renders the finished RunReport into the section 11 human layout, the transformation HC-R006 moves out of the print_report sink into the pure core. report is the assembled RunReport. It returns the report text — the chains, links and vocabularies found, the permutations run and failures, the adversarial inputs rejected, the honesty and chain-contract results, the state-machine tallies, and the totals — laid out as section 11 shows. run_suite calls it and hands the string to print_report. It reads no world and returns pure data; the write is print_report's."
  boundary_in fn mutate_source : (source: str) -> list<Mutant> | Fault invokes run_source_mutation note "the published generator entry for mutation adequacy (section 9.6). Pass the complete source unchanged to run_source_mutation and return its result."

  orchestrator fn run_source_mutation : (source: str) -> list<Mutant> | Fault invokes parse_source, source_mutants note "read the Python root through parse_source and return the result of source_mutants. The CLI uses the same reader and generator directly."
  fn source_mutants : (root: Node) -> list<Mutant> | Fault invokes _number_mutants, _boolean_mutants, _membership_mutants pure_call "honest-parse-tree.walk" note "generates every mechanical mutant of a module's source for the adequacy measure (section 9.6). root is the parsed root of the module source. It applies each of the seven change kinds to every place it fits — the way the generators enumerate a Set — and returns one Mutant per change: a swapped comparison, a shifted number, a flipped condition, a replaced constant, a swapped result, a removed line, a changed membership or key, each carrying its exact parsed mutation-site span and the original and replacement text. For the Python and/or condition flip that site is the operator token alone. It returns a Fault when the source does not parse, because a mutant can only be made from parseable source. The mutants are run out of process by the memory-capped harness, never here, because an infinite-loop mutant must not run inline; source_mutants only produces the changes. It reads no world and returns pure data or a Fault." note "The Python membership pass emits a separate mutant at every parsed in or not in comparison operator, after the constant-replacement pass. It keeps every operand and neighboring operator intact."
  fn _number_mutants : (root: Node) -> list<Mutant> pure_call "honest-parse-tree.walk" note "walk the parsed Python root in order. Select integer nodes except tokens ending in j or J. Decode the token with its case-insensitive 0x, 0o or 0b prefix as hexadecimal, octal or binary. Decode unprefixed digits as decimal, including leading-zero tokens from the parser. Accept the integer grammar's underscore separators. For each selected node return one number_shift mutant with the existing original text and span and the numeric value plus one as decimal text. Unary signs belong to the parent operator. source_mutants places this list after comparisons and before condition changes."
  fn _boolean_mutants : (root: Node) -> list<Mutant> pure_call "honest-parse-tree.walk" note "enumerates the parsed Python Boolean operator tokens and/or in source order (spec 9.6). root is the parsed Python syntax tree. Each token contributes one condition_flip Mutant with the token byte span alone, original equal to the token text, and replacement equal to the other operator. The surrounding expression, operands, grouping and whitespace remain outside that span. Strings and comments provide no operator tokens. With no applicable operator it returns an empty list. source_mutants places these records in the existing condition-flip pass. It produces records only and does not execute or rewrite the source."
  fn _membership_mutants : (root: Node) -> list<Mutant> pure_call "honest-parse-tree.walk" note "Traverse the parsed Python root in source order. Select each in or not in operator token whose direct parent is a comparison_operator node. A chained comparison supplies one independent mutation per membership operator in left-to-right order, even when the same spelling appears several times. Emit one membership_change Mutant per selected token with only its parsed source span and exact original text. An in token is replaced by not in, and a not in token is replaced by in. A single parsed not in token includes the spacing or line continuation between its words. Leave all source outside its token span unchanged. A for clause, comprehension iterator, string or comment is outside this pass. With no matching operator, return an empty list. The helper returns mutation records and performs no rewrite."

  fn classify_mutant_result : (baseline_output: str, mutant_output: str, completed: bool) -> MutantResult note "judges one mutant run against the baseline (section 9.6), the pure judge of the mutation engine. run_suite runs the unchanged source and each mutant out of process with run_mutant_suite and hands this function the observed outputs; the running is the memory-capped harness's boundary and the judging is this function's pure work. baseline_output is the conformance suite's observed output on the unchanged source, which must already pass; mutant_output is its output on the changed source; completed says whether the mutant run finished within its time and memory bound. It returns a MutantResult: caught when the mutant output shows at least one case failed; set_aside with the demonstration as its reason when the mutant output is identical to the baseline, so the change cannot alter the result; and undecided with the bound as its reason when completed is false, because a run that hit its bound produced no verdict and nothing may be claimed about it — recording it as caught would assert a detection that did not happen and fail in the direction that hides the defect. Adequacy requires caught plus set_aside to equal the total with none left undecided. It reads no world and returns pure data."
  fn generate_scaffolding : (chain_name: str, links: list<Link>) -> str note "generates the Gherkin step scaffolding for a chain from its link declarations (section 8.2), the pure function run_suite drives when scaffolding is produced. chain_name is the chain the feature targets; links are its declared links, the link_declarations load_under_test read off the chain. It returns a step-module source string whose handlers are pure functions that take the immutable context plus bound captures and return a new context, wired through a register(registry) that returns the registry — never through decorators or a mutable shared context, matching honest-gherkin's step-module contract. run_suite hands the string to write_scaffolding, which writes the do-not-edit file; the developer writes only the .feature files against it. The scaffolding it emits is template material. It reads no world and returns the generated source as a string."
  fn build_proof_event : (function_name: str, scenario: str, cases_run: int, outcome: ProofOutcome, line_coverage: int, branch_coverage: int) -> ProofEvent note "builds one hf.proof.checked proof event for a function honest-test proved (section 8.5), the pure builder run_suite drives per proven function. function_name is the fully-qualified name that is the function's gherkin requirement and its function-point unit; scenario is the gherkin scenario name; cases_run is how many cases ran; outcome is proved or failed; line_coverage and branch_coverage are the function's coverage percentages. A function earns proved only when honesty, full coverage and the gherkin's Then value oracle all hold; a run where any does not emits failed. It returns the ProofEvent record, which run_suite hands to emit_proof_event to emit through the injected honest-observe runtime. It reads no world and returns pure data; the emit is the sink's boundary."
  # ============================================================================================
  # The value-oracle engine (section 8.6). A sibling module's conformance runner enters evaluate_case,
  # the door, to run one portable suite case: the orchestrator resolves the case and drives the comparison,
  # the boundary runs the injected function under test, and pure helpers judge. The §8.4 protocol-assertion
  # step library and the §8.6 value-assertion step library are template files honest-test ships and
  # read_template reads, not functions in honest-test's own call graph, so they are not declared here.
  # ============================================================================================
  boundary_in fn evaluate_case : (case: SuiteCase, function_map: dict<str, Callable>) -> Result | Fault invokes run_case note "the value-oracle door (section 8.6), the one a sibling module's conformance runner enters to run one portable suite case and compare the function's output against the known-good value — the leg that earns a function proved, because auto-generation checks properties and shape but never which value is correct. case is the suite.json case: the function name, the call's arguments given as a single input, a positional args list or a keyword kwargs map, and the expected value. function_map maps each name a $ref or $call can hold to its callable, so a function that takes another function is reachable by naming it with no callable embedded in the data. evaluate_case hands the case and the map to run_case and returns what run_case returned: honest-type's ok Result carrying the output when it equals the expected value, honest-type's err Result carrying an expected-vs-got fault when they differ, or a honest-test Fault when a named function or expression is unknown. The ok arm is what earns the value leg of proved (section 8.5). It is a door: the sibling enters here by import, the running of the injected function is the engine's boundary realized by run_resolved_call, and evaluate_case itself only hands its input to the orchestrator."
  orchestrator fn run_case : (case: SuiteCase, function_map: dict<str, Callable>) -> Result | Fault invokes resolve_call, run_resolved_call, compare_output note "the value-oracle orchestrator (section 8.6), the sequence evaluate_case hands one case to. It resolves the case against the function map with resolve_call, and when that returns a Fault — a named function or expression the map does not hold — it passes the Fault outward and runs nothing. Otherwise it has a ResolvedCall, which it runs at the boundary with run_resolved_call to obtain the function's output, then judges the output against the resolved expected value with compare_output and returns the ok or err Result. case is the suite case; function_map is the name-to-callable map. It holds the one decision of the value-oracle path — a case that could not resolve never runs — and composes no other orchestrator. It returns the Result on a resolved case or the Fault resolve_call answered."
  fn resolve_call : (case: SuiteCase, function_map: dict<str, Callable>) -> ResolvedCall | Fault note "resolves one suite case against the function map into a runnable ResolvedCall, the pure first half of the value oracle (section 8.6). case is the suite case; function_map maps each name a $ref or $call can hold to its callable. It resolves the function name and each portable argument against the map — a literal is itself, a $ref is looked up to its callable, and a $call becomes a resolved application node carrying its looked-up callable and its own resolved arguments, so a case is a tree of applications resolved bottom-up — and resolves the expected value the same way. It returns a ResolvedCall carrying the concrete callable, the resolved positional and keyword arguments, and the resolved expected value, ready for run_resolved_call to run. It returns a honest-test Fault when any name or expression is not in the map, the case that could not run. It reads no world and runs no code: it only reads the map and reshapes the case, so every execution waits for the boundary. It returns pure data or a Fault."
  reader fn run_resolved_call : (resolved: ResolvedCall) -> any side_effect reads "process" note "runs one resolved value-oracle call at the engine's boundary (section 8.6), honest-test executing the injected function under test — code it did not write — which is what makes the value oracle an engine. resolved is the ResolvedCall resolve_call produced: a concrete callable, its resolved arguments, and the expected value. It applies each resolved $call application bottom-up and then invokes the function under test by single, positional or keyword arguments, and drives an awaitable result to completion itself so an async function is checkable, returning the finished value rather than a promise its caller must await. It returns the function's output for compare_output to judge. All names are already resolved, so it reaches no map and reads no file; its one side effect is the process-level effect of running the caller's injected code, which may do anything, and reading back what it returned. The judging is compare_output's pure work, not the boundary's."
  fn compare_output : (output: any, expected: any) -> Result note "judges one value-oracle output against the known-good value (section 8.6), the pure verdict of the engine. output is what run_resolved_call ran the function to; expected is the resolved known-good value from the ResolvedCall. It returns honest-type's ok Result carrying the output when the output equals the expected value, and honest-type's err Result carrying an expected-vs-got fault when they differ. The output is compared whole, so a function that returns a Result has its Result as its expected value. The ok arm is the value leg of proved (section 8.5); an err arm is a wrong value. It reads no world and returns pure data."

  # ============================================================================================
  # The CLI run and the pytest collection hook are host-started. The published value-oracle door
  # evaluate_case runs one portable suite case. The boundaryless generators and checks have their own
  # published entries in honest-test-pure.hd.
  # ============================================================================================
  entry "call:cli" -> run_cli
  entry "call:pytest" -> check_test_body

  entry "export honest_test" -> test_body_violations
  entry "export honest_test" -> verify_purity
  entry "export honest_test" -> detect_mutation
  entry "export honest_test" -> test_idempotency
  entry "export honest_test" -> verify_under_monitor
  entry "export honest_test" -> test_chain_contracts
  entry "export honest_test" -> test_auth_honesty
  entry "export honest_test" -> test_persist_schema_contract
  entry "export honest_test" -> test_startup_isolation
  entry "export honest_test" -> mutate_source

  # The value-oracle engine a sibling module enters by import: the door evaluate_case.
  entry "export honest_test" -> evaluate_case
